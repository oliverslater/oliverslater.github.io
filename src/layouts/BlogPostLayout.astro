---
import Layout from "./Layout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ReadingProgressBar from "../components/ReadingProgressBar.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import { profileData } from "../data/siteData";
import { formatDate } from "../utils/date";
import {
  getCanonicalSiteUrl,
  getTechArticleSchema,
  SEO_CONFIG,
} from "../utils/schema";

interface Props {
  frontmatter: {
    title: string;
    seoTitle?: string;
    description: string;
    pubDate: Date | string;
    lastUpdated?: Date | string;
    updatedDate?: Date | string;
    heroImage?: string;
    categories?: string[];
    category?: string;
    tags?: string[];
  };
  headings?: {
    depth: number;
    slug: string;
    text: string;
  }[];
  post?: any;
}

const { frontmatter, headings = [], post } = Astro.props;

const postCategories =
  frontmatter.categories && frontmatter.categories.length > 0
    ? frontmatter.categories
    : frontmatter.category
      ? [frontmatter.category]
      : [];
const postTags = frontmatter.tags || [];

const rawUpdatedDate = frontmatter.lastUpdated || frontmatter.updatedDate;
const hasValidUpdatedDate =
  Boolean(rawUpdatedDate) &&
  new Date(rawUpdatedDate!).getTime() >=
    new Date(frontmatter.pubDate).getTime();

const effectiveUpdatedDate = hasValidUpdatedDate ? rawUpdatedDate : undefined;
const formattedDate = formatDate(frontmatter.pubDate);
const formattedUpdatedDate = effectiveUpdatedDate
  ? formatDate(effectiveUpdatedDate)
  : null;

const siteUrl = getCanonicalSiteUrl(Astro.site);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const postBody = post?.body || "";
const wordCount = postBody
  ? postBody.trim().split(/\s+/).filter(Boolean).length
  : undefined;
const readingTimeMinutes = wordCount
  ? Math.max(1, Math.ceil(wordCount / 200))
  : undefined;
const timeRequired = readingTimeMinutes
  ? `PT${readingTimeMinutes}M`
  : undefined;

// Resolve PageCMS heroImage or fallback to dynamic Open Graph image
const rawHeroImage = frontmatter.heroImage?.trim();
const hasExplicitHeroImage =
  Boolean(rawHeroImage) &&
  !["none", "null", "false", "no"].includes(rawHeroImage!.toLowerCase());

const dynamicOgImage = post
  ? `/open-graph/blog/${new Date(frontmatter.pubDate).getFullYear()}/${String(new Date(frontmatter.pubDate).getMonth() + 1).padStart(2, "0")}/${post.id}.png`
  : SEO_CONFIG.defaultOgImage;
const heroImage = hasExplicitHeroImage ? rawHeroImage! : dynamicOgImage;
const resolvedHeroImage = new URL(heroImage, canonicalURL).toString();

const techArticleSchema = getTechArticleSchema({
  title: frontmatter.title,
  description: frontmatter.description,
  url: canonicalURL.toString(),
  image: resolvedHeroImage,
  pubDate: frontmatter.pubDate,
  updatedDate: effectiveUpdatedDate,
  categories: postCategories,
  tags: postTags,
  wordCount,
  timeRequired,
  siteUrl,
});
const rawPageTitle = frontmatter.seoTitle || frontmatter.title;
const pageTitle = rawPageTitle.includes(profileData.name)
  ? rawPageTitle
  : `${rawPageTitle} | ${profileData.name}`;
---

<Layout
  title={pageTitle}
  description={frontmatter.description}
  image={heroImage}
  type="article"
  publishedTime={frontmatter.pubDate}
  modifiedTime={effectiveUpdatedDate}
  author={profileData.name}
  categories={postCategories}
  tags={postTags}
  schema={techArticleSchema}
>
  <ReadingProgressBar />

  <div class="relative max-w-5xl mx-auto lg:flex lg:items-start lg:gap-10 xl:gap-12">
    <article class="flex-1 min-w-0 max-w-3xl">
      <!-- Back to blog navigation -->
      <div class="mb-8">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
        >
          <span aria-hidden="true">&larr;</span> Back to all posts
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-[#ffffff10]">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-mono text-[var(--sec)] mb-3">
          {postCategories.length > 0 && (
            <>
              {postCategories.map((cat) => (
                <a
                  href={`/blog?category=${encodeURIComponent(cat)}`}
                  class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-purple-100 dark:bg-[#ffffff15] text-[var(--sec)] border border-purple-200/60 dark:border-[#ffffff10] hover:bg-purple-200 dark:hover:bg-[#ffffff25] transition-colors"
                >
                  {cat}
                </a>
              ))}
              <span
                class="text-neutral-400 dark:text-neutral-600"
                aria-hidden="true"
              >
                ·
              </span>
            </>
          )}
          <time datetime={new Date(frontmatter.pubDate).toISOString()}>
            {formattedDate}
          </time>
          {readingTimeMinutes && (
            <>
              <span
                class="text-neutral-400 dark:text-neutral-600"
                aria-hidden="true"
              >
                ·
              </span>
              <span class="text-[var(--white-icon)]">
                {readingTimeMinutes} min read
              </span>
            </>
          )}
          {formattedUpdatedDate && (
            <>
              <span
                class="text-neutral-400 dark:text-neutral-600"
                aria-hidden="true"
              >
                ·
              </span>
              <span class="text-[var(--white-icon)]">
                Last updated:{" "}
                <time datetime={new Date(effectiveUpdatedDate!).toISOString()}>
                  {formattedUpdatedDate}
                </time>
              </span>
            </>
          )}
        </div>

        <h1
          id="article-title"
          class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[var(--white)] mb-4 leading-tight"
        >
          {frontmatter.title}
        </h1>

        <p
          id="article-description"
          class="text-lg text-[var(--white-icon)] leading-relaxed mb-6"
        >
          {frontmatter.description}
        </p>

        {postTags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {postTags.map((tag) => (
              <a
                href={`/blog?q=${encodeURIComponent(tag)}`}
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-purple-50 dark:bg-[#ffffff08] text-[var(--sec)] border border-purple-200/60 dark:border-[#ffffff10] hover:bg-purple-100 dark:hover:bg-[#ffffff15] transition-colors"
                title={`Search for #${tag}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        {hasExplicitHeroImage && (
          <div class="mt-8 rounded-xl overflow-hidden border border-[#ffffff10]">
            <img
              src={rawHeroImage}
              alt={frontmatter.title}
              class="w-full h-auto object-cover max-h-[480px]"
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </header>

      <!-- Mobile / Tablet Collapsible Table of Contents -->
      <TableOfContents headings={headings} mode="mobile" />

      <!-- Post Body Content -->
      <div class="prose dark:prose-invert max-w-none prose-headings:font-medium prose-headings:text-[var(--white)] prose-p:text-[var(--white-icon)] prose-p:leading-relaxed prose-strong:text-[var(--white)] prose-a:text-[var(--sec)] prose-a:underline-offset-4 prose-code:text-[var(--sec)] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-pre:bg-neutral-900 dark:prose-pre:bg-[#141414] prose-pre:text-neutral-100 prose-pre:border prose-pre:border-neutral-800 dark:prose-pre:border-[#ffffff10] prose-li:text-[var(--white-icon)] prose-hr:border-neutral-200 dark:prose-hr:border-[#ffffff10]">
        <slot />
      </div>

      <!-- Related Articles Topic Cluster -->
      <RelatedArticles
        currentId={post?.id || ""}
        categories={postCategories}
        tags={postTags}
      />

      <!-- Article Footer -->
      <footer class="mt-14 pt-8 border-t border-[#ffffff10] flex items-center justify-between font-mono text-xs text-[var(--white-icon)]">
        <a href="/blog" class="hover:text-[var(--white)] transition-colors">
          &larr; Back to all posts
        </a>
        <a href="#top" class="hover:text-[var(--white)] transition-colors">
          Back to top &uarr;
        </a>
      </footer>
    </article>

    <!-- Desktop Sticky Sidebar Table of Contents -->
    <TableOfContents headings={headings} mode="desktop" />
  </div>

  <!-- Architecture Diagram Lightbox Modal -->
  <dialog
    id="diagram-lightbox"
    class="diagram-lightbox m-auto p-0 rounded-2xl bg-neutral-950/95 dark:bg-[#101010]/95 text-[var(--white)] border border-neutral-800 dark:border-[#ffffff18] shadow-2xl backdrop:backdrop-blur-md backdrop:bg-black/75 max-w-[95vw] max-h-[92vh] w-[1100px] h-[780px] overflow-hidden flex flex-col focus:outline-none"
    closedby="any"
    aria-labelledby="lightbox-title"
  >
    <!-- Header bar -->
    <div class="flex items-center justify-between px-5 py-3 border-b border-[#ffffff15] bg-neutral-900/60 select-none">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-medium text-[var(--sec)] uppercase tracking-wider">
          Architecture Diagram
        </span>
        <span
          id="lightbox-title"
          class="text-xs text-[var(--white-icon)] font-mono"
        >
          · Interactive Viewer
        </span>
      </div>
      <div class="flex items-center gap-1.5 font-mono text-xs">
        <button
          type="button"
          id="lightbox-zoom-out"
          class="p-1.5 px-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-[var(--white)] transition-colors"
          title="Zoom out (-)"
          aria-label="Zoom out"
        >
          &minus;
        </button>
        <span
          id="lightbox-zoom-level"
          class="px-2 py-1 text-xs text-[var(--white-icon)] select-none"
        >
          100%
        </span>
        <button
          type="button"
          id="lightbox-zoom-in"
          class="p-1.5 px-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-[var(--white)] transition-colors"
          title="Zoom in (+)"
          aria-label="Zoom in"
        >
          &plus;
        </button>
        <button
          type="button"
          id="lightbox-reset"
          class="px-2.5 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
          title="Reset zoom and position (0)"
        >
          Reset
        </button>
        <button
          type="button"
          id="lightbox-close"
          class="ml-2 p-1.5 px-2.5 rounded-lg bg-neutral-800 hover:bg-rose-500/20 hover:text-rose-400 text-[var(--white)] transition-colors"
          title="Close viewer (Esc)"
          aria-label="Close dialog"
        >
          &times;
        </button>
      </div>
    </div>

    <!-- Interactive Canvas Stage -->
    <div
      id="lightbox-stage-container"
      class="flex-1 w-full h-full overflow-hidden relative flex items-center justify-center p-4 cursor-grab active:cursor-grabbing select-none"
    >
      <div
        id="lightbox-stage"
        class="transition-transform duration-75 origin-center w-full h-full flex items-center justify-center"
      >
        <!-- Cloned SVG inserted here dynamically -->
      </div>
    </div>

    <!-- Footer helper hint -->
    <div class="px-5 py-2 border-t border-[#ffffff10] bg-neutral-900/40 text-[11px] font-mono text-[var(--white-icon)] flex items-center justify-between">
      <span>Drag to pan · Scroll to zoom</span>
      <span>
        Shortcuts:{" "}
        <kbd class="px-1 py-0.5 rounded bg-neutral-800 text-[10px]">+</kbd>{" "}
        <kbd class="px-1 py-0.5 rounded bg-neutral-800 text-[10px]">-</kbd>{" "}
        <kbd class="px-1 py-0.5 rounded bg-neutral-800 text-[10px]">0</kbd>{" "}
        <kbd class="px-1 py-0.5 rounded bg-neutral-800 text-[10px]">Esc</kbd>
      </span>
    </div>
  </dialog>

  <script src="../scripts/blog-enhancements.ts"></script>
</Layout>
