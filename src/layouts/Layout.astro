---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profileData, blogConfig, pageSeoData } from "../data/siteData";
import { SEO_CONFIG } from "../utils/schema";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  categories?: string[];
  tags?: string[];
  keywords?: string[];
  schema?: Record<string, any>;
}

const {
  title: inputTitle,
  description = pageSeoData.home.description ||
    profileData.metaDescription ||
    profileData.bio,
  image = SEO_CONFIG.defaultOgImage,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  author = profileData.name,
  categories = [],
  tags = [],
  keywords = [],
  schema,
} = Astro.props;

const allMetaKeywords = Array.from(
  new Set([...categories, ...tags, ...keywords]),
);

// Smart Title Formatter with Safe Fallbacks:
// 1. If inputTitle is omitted/empty: default to full root title (pageSeoData.home.title)
// 2. If inputTitle already contains the brand name: use it verbatim
// 3. Otherwise: format as `${inputTitle} | ${profileData.name} – Enterprise Cloud Architect`
const title =
  !inputTitle || inputTitle === "Home"
    ? pageSeoData.home.title
    : inputTitle.includes(profileData.name)
      ? inputTitle
      : `${inputTitle} | ${profileData.name} – Enterprise Cloud Architect`;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || profileData.website,
);
const imageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" />
    <meta name="generator" content={Astro.generator} />

    <!-- RSS & Atom Syndication Feeds -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profileData.name} Blog (RSS Feed)`}
      href={blogConfig.feedPath}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profileData.name} Blog (RSS 2.0)`}
      href={blogConfig.rssPath}
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots -->
    <meta
      name="robots"
      content={noindex ? SEO_CONFIG.robots.noindex : SEO_CONFIG.robots.default}
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {allMetaKeywords.length > 0 && (
      <meta name="keywords" content={allMetaKeywords.join(", ")} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Article specific metadata */}
    {type === "article" && publishedTime && (
      <meta
        property="article:published_time"
        content={new Date(publishedTime).toISOString()}
      />
    )}
    {type === "article" && modifiedTime && (
      <meta
        property="article:modified_time"
        content={new Date(modifiedTime).toISOString()}
      />
    )}
    {type === "article" && <meta property="article:author" content={author} />}
    {type === "article" &&
      categories.map((cat) => (
        <meta property="article:section" content={cat} />
      ))}
    {type === "article" &&
      allMetaKeywords.map((keyword) => (
        <meta property="article:tag" content={keyword} />
      ))}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageURL} />

    <!-- Structured Data (Schema.org) JSON-LD -->
    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      ></script>
    )}

    <!-- Zero-FOUC System/Stored Theme Preference Initializer -->
    <script is:inline>
      const getTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };
      const theme = getTheme();
      document.documentElement.classList[theme === "dark" ? "add" : "remove"](
        "dark",
      );

      if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-[var(--background)] text-[var(--white)] font-sans antialiased selection:bg-[var(--sec)] selection:text-black">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[var(--sec)] focus:text-black focus:font-semibold focus:rounded-xl focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white transition-all"
    >
      Skip to main content
    </a>
    <Header />
    <main
      id="main-content"
      tabindex="-1"
      class="flex-1 w-full max-w-5xl mx-auto px-5 sm:px-8 pt-24 sm:pt-32 pb-16 focus:outline-none"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
