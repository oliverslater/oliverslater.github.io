---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/cv", label: "CV" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const normCurrent = normalize(currentPath);

const isActive = (href: string) => {
  const normHref = normalize(href);
  if (normHref === "/") {
    return normCurrent === "/";
  }
  return normCurrent === normHref || normCurrent.startsWith(`${normHref}/`);
};
---

<div class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-auto max-w-[95vw] no-print">
  <nav
    id="main-nav"
    class="flex items-center gap-1 sm:gap-4 px-4 sm:px-6 py-2.5 rounded-full border border-neutral-200/80 dark:border-[#ffffff15] bg-white/85 dark:bg-[#141414]/85 backdrop-blur-xl shadow-xl transition-all duration-300"
    aria-label="Primary navigation"
  >
    <!-- Brand / Name -->
    <a
      href="/"
      class="group flex items-center gap-1.5 font-medium text-xs sm:text-sm tracking-tight text-[var(--white)] hover:text-neutral-900 dark:hover:text-white transition-colors mr-1 sm:mr-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)] rounded-full px-1.5 py-0.5"
      aria-label="Oliver Slater Home"
    >
      <span class="font-semibold">os</span>
    </a>

    <div class="w-px h-4 bg-neutral-200 dark:bg-[#ffffff15]"></div>

    <!-- Navigation links -->
    <div class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            data-nav-item="true"
            class:list={[
              "relative flex items-center gap-1.5 px-3 py-1 rounded-full text-xs sm:text-sm transition-all duration-200 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]",
              active
                ? "text-neutral-900 dark:text-white font-medium bg-neutral-200/70 dark:bg-[#ffffff10]"
                : "text-[var(--white-icon)] hover:text-neutral-900 dark:hover:text-white",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {active && (
              <span
                class="nav-active-dot w-1.5 h-1.5 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] animate-pulse"
                aria-hidden="true"
              ></span>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>

    <div class="w-px h-4 bg-neutral-200 dark:bg-[#ffffff15] ml-1"></div>

    <ThemeToggle />
  </nav>
</div>

<script>
  function syncActiveNav() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
      "#main-nav a[data-nav-item='true']",
    );
    const pathname = window.location.pathname.replace(/\/+$/, "") || "/";

    navLinks.forEach((link) => {
      const href = link.getAttribute("href")?.replace(/\/+$/, "") || "/";
      const isMatch =
        href === "/"
          ? pathname === "/"
          : pathname === href || pathname.startsWith(href + "/");

      if (isMatch) {
        link.setAttribute("aria-current", "page");
        link.classList.add(
          "text-neutral-900",
          "dark:text-white",
          "font-medium",
          "bg-neutral-200/70",
          "dark:bg-[#ffffff10]",
        );
        link.classList.remove("text-[var(--white-icon)]");
        if (!link.querySelector(".nav-active-dot")) {
          const dot = document.createElement("span");
          dot.className =
            "nav-active-dot w-1.5 h-1.5 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] animate-pulse";
          dot.setAttribute("aria-hidden", "true");
          link.prepend(dot);
        }
      } else {
        link.removeAttribute("aria-current");
        link.classList.remove(
          "text-neutral-900",
          "dark:text-white",
          "font-medium",
          "bg-neutral-200/70",
          "dark:bg-[#ffffff10]",
        );
        link.classList.add("text-[var(--white-icon)]");
        const dot = link.querySelector(".nav-active-dot");
        if (dot) dot.remove();
      }
    });
  }

  syncActiveNav();
  document.addEventListener("astro:after-swap", syncActiveNav);
</script>
