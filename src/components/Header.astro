---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/cv', label: 'CV' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<div class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-auto max-w-[95vw] no-print">
  <nav
    id="main-nav"
    class="flex items-center gap-1 sm:gap-4 px-4 sm:px-6 py-2.5 rounded-full border border-[#ffffff15] dark:border-[#ffffff15] border-neutral-200/80 bg-[#141414]/85 dark:bg-[#141414]/85 bg-white/85 backdrop-blur-xl shadow-xl transition-all duration-300"
  >
    <!-- Brand / Name -->
    <a
      href="/"
      class="group flex items-center gap-1.5 font-medium text-xs sm:text-sm tracking-tight text-[var(--white)] hover:text-white transition-colors mr-1 sm:mr-2"
    >
      <span class="font-semibold">os</span>
      <span class="text-[var(--sec)]">.</span>
    </a>

    <div class="w-px h-4 bg-[#ffffff15] dark:bg-[#ffffff15] bg-neutral-200"></div>

    <!-- Navigation links -->
    <div class="flex items-center gap-1 sm:gap-2">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'relative flex items-center gap-1.5 px-3 py-1 rounded-full text-xs sm:text-sm transition-all duration-200 group',
                active
                  ? 'text-white font-medium bg-[#ffffff10] dark:bg-[#ffffff10] bg-neutral-100'
                  : 'text-[var(--white-icon)] hover:text-white',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {active && (
                <span class="w-1.5 h-1.5 rounded-full bg-[#A9FF5B] animate-pulse" aria-hidden="true"></span>
              )}
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </div>

    <div class="w-px h-4 bg-[#ffffff15] dark:bg-[#ffffff15] bg-neutral-200 ml-1"></div>

    <ThemeToggle />
  </nav>
</div>
