---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
  mode?: "all" | "mobile" | "desktop";
}

const { headings = [], mode = "all" } = Astro.props;

// Filter for <h2> and <h3> headings
const filteredHeadings = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.text.trim() !== "",
);
---

{filteredHeadings.length > 0 && (
  <>
    {/* Mobile / Tablet Collapsible Table of Contents */}
    {(mode === "all" || mode === "mobile") && (
      <nav
        class="lg:hidden mb-8 p-4 rounded-xl border border-neutral-200/80 dark:border-[#ffffff10] bg-neutral-50/70 dark:bg-[#1414149c] backdrop-blur-xs"
        aria-label="Table of contents"
      >
        <details class="toc-mobile group">
          <summary class="flex items-center justify-between cursor-pointer font-mono text-xs font-medium text-[var(--white)] select-none outline-none">
            <span class="flex items-center gap-2">
              <svg
                class="w-3.5 h-3.5 text-[var(--sec)]"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h7"
                />
              </svg>
              Table of Contents ({filteredHeadings.length})
            </span>
            <svg
              class="w-4 h-4 text-[var(--white-icon)] transition-transform duration-200 group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </summary>
          <div class="mt-3 pt-3 border-t border-neutral-200/60 dark:border-[#ffffff10] space-y-1">
            {filteredHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class={`toc-link depth-${heading.depth} block py-1 font-mono text-xs hover:text-[var(--sec)] transition-colors`}
              >
                {heading.depth === 3 && (
                  <span class="opacity-40 mr-1.5" aria-hidden="true">
                    └
                  </span>
                )}
                {heading.text}
              </a>
            ))}
          </div>
        </details>
      </nav>
    )}

    {/* Desktop Sticky Sidebar Table of Contents */}
    {(mode === "all" || mode === "desktop") && (
      <aside
        class="hidden lg:block w-64 shrink-0"
        aria-label="Table of contents"
      >
        <div class="sticky top-28 toc-sidebar pr-2">
          <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-[#ffffff10] bg-white dark:bg-[#1414149c] shadow-xs">
            <p class="font-mono text-[11px] font-semibold tracking-wider uppercase text-[var(--sec)] mb-3 flex items-center gap-1.5">
              <svg
                class="w-3.5 h-3.5"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 6h16M4 12h16M4 18h7"
                />
              </svg>
              Table of Contents
            </p>
            <nav class="space-y-0.5" id="desktop-toc-nav">
              {filteredHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`toc-link depth-${heading.depth}`}
                  title={heading.text}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </aside>
    )}
  </>
)}
