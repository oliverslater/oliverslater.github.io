---
import SocialLinks from './SocialLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 border-t border-[#ffffff10] mt-auto no-print">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex flex-col items-center sm:items-start gap-1">
      <div class="flex items-center gap-2 text-sm text-[var(--white)] font-medium">
        <span>Oliver Slater</span>
        <span class="text-[var(--sec)]">·</span>
        <span class="text-xs text-[var(--white-icon)]">Cloud Architect</span>
      </div>
      <p class="text-xs text-[var(--white-icon)] font-mono">
        © {currentYear} All rights reserved. Powered by Astro.
      </p>
    </div>

    <!-- Social links -->
    <SocialLinks variant="footer" />
  </div>
</footer>
