---
interface Props {
  title: string;
  badge?: string;
  class?: string;
}

const { title, badge, class: className = '' } = Astro.props;
---

<section class:list={['mb-14 print-page-break-inside-avoid', className]}>
  <div class="flex items-center justify-between pb-3 mb-8 border-b border-[#ffffff10]">
    <div class="flex items-center gap-3">
      <h2 class="text-2xl font-semibold tracking-tight text-[var(--white)]">
        {title}
      </h2>
      {
        badge && (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-[var(--white-icon-tr)] text-[var(--sec)] border border-[#ffffff10]">
            {badge}
          </span>
        )
      }
    </div>
  </div>

  <div class="space-y-8">
    <slot />
  </div>
</section>
