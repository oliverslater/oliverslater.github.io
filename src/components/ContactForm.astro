---
// src/components/ContactForm.astro
import { profileData } from "../data/siteData";

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || "";
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";
const hcaptchaKey = import.meta.env.PUBLIC_HCAPTCHA_SITEKEY || "";
const thankYouUrl = new URL("/thank-you", profileData.website).toString();
---

<form
  id="contact-form"
  action={formEndpoint}
  method="POST"
  class="space-y-5 max-w-xl"
  novalidate
>
  {web3FormsKey && (
    <input type="hidden" name="access_key" value={web3FormsKey} />
  )}
  <!-- Web3Forms redirect URL after success -->
  <input type="hidden" name="redirect" value={thankYouUrl} />
  <!-- Honeypot for spam protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
  />

  <!-- Name field -->
  <div>
    <label
      for="contact-name"
      class="block text-xs font-mono text-[var(--white-icon)] uppercase tracking-wider mb-2"
    >
      Name <span class="text-[var(--sec)]">*</span>
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      placeholder="Your Name"
      class="w-full px-4 py-3 rounded-xl text-sm bg-white dark:bg-[#1414149c] text-[var(--white)] placeholder:text-neutral-400 dark:placeholder:text-neutral-500 border border-neutral-200/80 dark:border-[var(--white-icon-tr)] focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] focus:outline-none shadow-sm transition-all"
    />
  </div>

  <!-- Email field -->
  <div>
    <label
      for="contact-email"
      class="block text-xs font-mono text-[var(--white-icon)] uppercase tracking-wider mb-2"
    >
      Email <span class="text-[var(--sec)]">*</span>
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="your.email@example.com"
      class="w-full px-4 py-3 rounded-xl text-sm bg-white dark:bg-[#1414149c] text-[var(--white)] placeholder:text-neutral-400 dark:placeholder:text-neutral-500 border border-neutral-200/80 dark:border-[var(--white-icon-tr)] focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] focus:outline-none shadow-sm transition-all"
    />
  </div>

  <!-- Subject field -->
  <div>
    <label
      for="contact-subject"
      class="block text-xs font-mono text-[var(--white-icon)] uppercase tracking-wider mb-2"
    >
      Subject
    </label>
    <input
      type="text"
      id="contact-subject"
      name="subject"
      placeholder="Architecture question, tech discussion, or saying hello..."
      class="w-full px-4 py-3 rounded-xl text-sm bg-white dark:bg-[#1414149c] text-[var(--white)] placeholder:text-neutral-400 dark:placeholder:text-neutral-500 border border-neutral-200/80 dark:border-[var(--white-icon-tr)] focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] focus:outline-none shadow-sm transition-all"
    />
  </div>

  <!-- Message field -->
  <div>
    <label
      for="contact-message"
      class="block text-xs font-mono text-[var(--white-icon)] uppercase tracking-wider mb-2"
    >
      Message <span class="text-[var(--sec)]">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      required
      placeholder="Feel free to ask an architectural question, share an interesting tech story, or say hello..."
      class="w-full px-4 py-3 rounded-xl text-sm bg-white dark:bg-[#1414149c] text-[var(--white)] placeholder:text-neutral-400 dark:placeholder:text-neutral-500 border border-neutral-200/80 dark:border-[var(--white-icon-tr)] focus:border-[var(--sec)] focus:ring-1 focus:ring-[var(--sec)] focus:outline-none shadow-sm transition-all resize-y"
    ></textarea>
  </div>

  <!-- hCaptcha Spam Protection -->
  <div class="pt-1">
    <div class="inline-block p-3 sm:p-3.5 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] hover:border-neutral-300 dark:hover:border-[#ffffff20] shadow-sm transition-all max-w-full overflow-x-auto">
      <div
        id="hcaptcha-container"
        class="h-captcha min-h-[78px] min-w-[300px]"
        data-captcha="true"
        {...(hcaptchaKey ? { "data-sitekey": hcaptchaKey } : {})}
      ></div>
    </div>
  </div>

  <script is:inline>
    // Synchronously set initial data-theme attribute before hCaptcha script loads
    (function () {
      var isDark = document.documentElement.classList.contains("dark");
      var container = document.getElementById("hcaptcha-container");
      if (container) {
        container.setAttribute("data-theme", isDark ? "dark" : "light");
      }
    })();
  </script>
  <!-- Submit button & status alerts -->
  <div class="space-y-4 pt-2">
    <button
      type="submit"
      id="contact-submit"
      class="inline-flex items-center justify-center px-6 py-3 rounded-xl text-sm font-semibold tracking-tight bg-[var(--sec)] text-white dark:text-black hover:opacity-90 transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed shadow-lg"
    >
      <span id="btn-text">Send Message</span>
      <svg
        id="btn-spinner"
        class="hidden w-4 h-4 ml-2 animate-spin text-white dark:text-black"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8v8H4z"
        ></path>
      </svg>
    </button>

    <!-- Inline Status Messages -->
    <div
      id="status-success"
      class="hidden p-4 rounded-xl text-sm font-mono border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      role="alert"
    >
      &check; Thank you! Your message has been sent successfully. I will get
      back to you soon.
    </div>

    <div
      id="status-error"
      class="hidden p-4 rounded-xl text-sm font-mono border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400"
      role="alert"
    >
      &cross; An error occurred while sending your message. Please try again or
      email directly.
    </div>
  </div>
</form>

<script>
  let themeObserver: MutationObserver | null = null;

  function setupContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text");
    const btnSpinner = document.getElementById("btn-spinner");
    const successMsg = document.getElementById("status-success");
    const errorMsg = document.getElementById("status-error");

    // Dynamic hCaptcha theme alignment with light/dark mode
    function syncCaptchaTheme() {
      const container = document.getElementById("hcaptcha-container");
      if (!container) return;

      const isDark = document.documentElement.classList.contains("dark");
      const targetTheme = isDark ? "dark" : "light";
      const currentTheme = container.getAttribute("data-theme");

      if (currentTheme !== targetTheme) {
        container.setAttribute("data-theme", targetTheme);

        const hcaptcha = (window as any).hcaptcha;
        if (
          hcaptcha &&
          typeof hcaptcha.render === "function" &&
          container.querySelector("iframe")
        ) {
          const sitekey =
            container.getAttribute("data-sitekey") ||
            "50b2fe65-b00b-4b9e-ad62-3ba471098be2";
          container.innerHTML = "";
          try {
            hcaptcha.render(container, {
              sitekey: sitekey,
              theme: targetTheme,
            });
          } catch (err) {
            console.warn("hCaptcha re-render error:", err);
          }
        }
      }
    }

    syncCaptchaTheme();

    if (themeObserver) {
      themeObserver.disconnect();
    }
    themeObserver = new MutationObserver(() => {
      syncCaptchaTheme();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Check if hCaptcha is present and completed
      const hCaptchaInput = form.querySelector<HTMLTextAreaElement>(
        'textarea[name="h-captcha-response"]',
      );
      if (hCaptchaInput && !hCaptchaInput.value) {
        if (errorMsg) {
          errorMsg.textContent =
            "✕ Please complete the captcha before sending.";
          errorMsg.classList.remove("hidden");
        }
        return;
      }

      // Hide prior alerts
      successMsg?.classList.add("hidden");
      errorMsg?.classList.add("hidden");

      // Set loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Sending...";
      btnSpinner?.classList.remove("hidden");

      try {
        const formData = new FormData(form);
        const endpoint = form.getAttribute("action") || "";

        if (!endpoint) {
          throw new Error("Contact form endpoint is not configured.");
        }

        // Convert to JSON payload if endpoint expects JSON
        const object = Object.fromEntries(formData);
        const jsonBody = JSON.stringify(object);

        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: jsonBody,
        });

        if (response.ok) {
          successMsg?.classList.remove("hidden");
          form.reset();
          (window as any).hcaptcha?.reset();
          window.location.href = "/thank-you";
        } else {
          (window as any).hcaptcha?.reset();
          const resData = await response.json().catch(() => null);
          if (errorMsg) {
            errorMsg.textContent = resData?.message
              ? `✕ ${resData.message}`
              : "✕ Failed to submit. Please check your form endpoint configuration.";
            errorMsg.classList.remove("hidden");
          }
        }
      } catch (err) {
        (window as any).hcaptcha?.reset();
        if (errorMsg) {
          errorMsg.textContent =
            "✕ Network error occurred. Please check your connection.";
          errorMsg.classList.remove("hidden");
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Send Message";
        btnSpinner?.classList.add("hidden");
      }
    });
  }

  setupContactForm();
  document.addEventListener("astro:after-swap", setupContactForm);
</script>

<!-- Web3Forms hCaptcha Client Script -->
<script
  is:inline
  src="https://web3forms.com/client/script.js"
  async
  defer
></script>
