---
// src/components/ContactForm.astro
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://api.web3forms.com/submit';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
---

<form
  id="contact-form"
  action={formEndpoint}
  method="POST"
  class="space-y-6 max-w-xl"
  novalidate
>
  {web3FormsKey && (
    <input type="hidden" name="access_key" value={web3FormsKey} />
  )}
  <!-- Honeypot for spam protection -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

  <!-- Name field -->
  <div>
    <label
      for="contact-name"
      class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-2"
    >
      Name <span class="text-neutral-400">*</span>
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      placeholder="Jane Doe"
      class="w-full px-3.5 py-2.5 rounded-md text-sm bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-600 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-neutral-100 focus:border-neutral-900 dark:focus:border-neutral-100 transition-colors"
    />
  </div>

  <!-- Email field -->
  <div>
    <label
      for="contact-email"
      class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-2"
    >
      Email <span class="text-neutral-400">*</span>
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="jane@example.com"
      class="w-full px-3.5 py-2.5 rounded-md text-sm bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-600 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-neutral-100 focus:border-neutral-900 dark:focus:border-neutral-100 transition-colors"
    />
  </div>

  <!-- Subject field -->
  <div>
    <label
      for="contact-subject"
      class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-2"
    >
      Subject
    </label>
    <input
      type="text"
      id="contact-subject"
      name="subject"
      placeholder="Collaboration / Project Inquiry"
      class="w-full px-3.5 py-2.5 rounded-md text-sm bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-600 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-neutral-100 focus:border-neutral-900 dark:focus:border-neutral-100 transition-colors"
    />
  </div>

  <!-- Message field -->
  <div>
    <label
      for="contact-message"
      class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-2"
    >
      Message <span class="text-neutral-400">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      required
      placeholder="Write your message here..."
      class="w-full px-3.5 py-2.5 rounded-md text-sm bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-600 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-neutral-100 focus:border-neutral-900 dark:focus:border-neutral-100 transition-colors resize-y"
    ></textarea>
  </div>

  <!-- Submit button & status alerts -->
  <div class="space-y-4">
    <button
      type="submit"
      id="contact-submit"
      class="inline-flex items-center justify-center px-5 py-2.5 rounded-md text-sm font-medium tracking-tight bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span id="btn-text">Send Message</span>
      <svg
        id="btn-spinner"
        class="hidden w-4 h-4 ml-2 animate-spin"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </button>

    <!-- Inline Status Messages -->
    <div
      id="status-success"
      class="hidden p-3.5 rounded-md text-sm font-mono border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
      role="alert"
    >
      &check; Thank you! Your message has been sent successfully. I will get back to you soon.
    </div>

    <div
      id="status-error"
      class="hidden p-3.5 rounded-md text-sm font-mono border border-red-500/30 bg-red-500/10 text-red-700 dark:text-red-400"
      role="alert"
    >
      &cross; An error occurred while sending your message. Please try again or email directly.
    </div>
  </div>
</form>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const successMsg = document.getElementById('status-success');
    const errorMsg = document.getElementById('status-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Hide prior alerts
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      // Set loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Sending...';
      btnSpinner?.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const endpoint = form.getAttribute('action') || 'https://api.web3forms.com/submit';

        // Convert to JSON payload if endpoint expects JSON
        const object = Object.fromEntries(formData);
        const jsonBody = JSON.stringify(object);

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: jsonBody,
        });

        if (response.ok) {
          successMsg?.classList.remove('hidden');
          form.reset();
        } else {
          const resData = await response.json().catch(() => null);
          if (errorMsg) {
            errorMsg.textContent = resData?.message
              ? `✕ ${resData.message}`
              : '✕ Failed to submit. Please check your form endpoint configuration.';
            errorMsg.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (errorMsg) {
          errorMsg.textContent = '✕ Network error occurred. Please check your connection.';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send Message';
        btnSpinner?.classList.add('hidden');
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
