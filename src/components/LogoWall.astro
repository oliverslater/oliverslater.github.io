---
import { technologiesData } from "../data/siteData";

interface TechnologyItem {
  name: string;
  tag: string;
  logo?: string;
}

const technologies: TechnologyItem[] = technologiesData.technologies;
---

<div class="relative overflow-x-hidden py-10 my-4 border-y border-[#ffffff10] dark:border-[#ffffff10] border-neutral-200">
  <!-- Gradient fade edge masks -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 sm:w-36 bg-gradient-to-r from-[var(--background)] to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 sm:w-36 bg-gradient-to-l from-[var(--background)] to-transparent z-20"></div>

  <div class="flex animate-scroll w-max will-change-transform">
    {[...technologies, ...technologies].map((tech, index) => (
      <div
        class="flex items-center gap-2.5 pr-10 sm:pr-14 group transition-all duration-300 select-none"
        aria-hidden={index >= technologies.length ? "true" : "false"}
      >
        {tech.logo ? (
          <img
            src={tech.logo}
            alt={tech.name}
            class="w-5 h-5 object-contain transition-transform group-hover:scale-110 flex-shrink-0 opacity-80 group-hover:opacity-100"
            width="20"
            height="20"
            loading="lazy"
            fetchpriority="low"
            decoding="async"
          />
        ) : (
          <span class="w-2 h-2 rounded-full bg-[var(--sec)] opacity-70 group-hover:scale-125 transition-transform" />
        )}
        <span class="text-base sm:text-lg font-medium text-[var(--white)] tracking-tight whitespace-nowrap group-hover:text-[var(--sec)] transition-colors">
          {tech.name}
        </span>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[var(--white-icon-tr)] text-[var(--white-icon)] border border-[#ffffff10] dark:border-[#ffffff10] border-neutral-200">
          {tech.tag}
        </span>
      </div>
    ))}
  </div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>
