---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import profileData from '../content/cv/profile.json';

const showEmail = (profileData as any).showEmail ?? (profileData as any).emailVisible ?? false;
const contactEmail = import.meta.env.CONTACT_EMAIL || import.meta.env.PUBLIC_CONTACT_EMAIL || (profileData as any).email || '';
---

<BaseLayout
  title={`Contact | ${profileData.name}`}
  description="Get in touch with Oliver Slater for cloud architecture, enterprise advisory, or platform engineering initiatives."
>
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-[#ffffff10]">
      <p class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
        Let's Talk
      </p>
      <h1 class="text-4xl sm:text-5xl font-medium tracking-tight text-[var(--white)] mb-3">
        Contact
      </h1>
      <p class="text-base text-[var(--white-icon)] leading-relaxed max-w-xl">
        Have an architecture project, consulting inquiry, or cloud transformation initiative? Send a message directly below or reach out via direct coordinates.
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        {showEmail && contactEmail ? (
          <div class="p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]">
            <span class="block text-neutral-500 mb-1">Direct Email</span>
            <a href={`mailto:${contactEmail}`} class="text-[var(--white)] hover:text-[var(--sec)] transition-colors break-all">
              {contactEmail}
            </a>
          </div>
        ) : (
          <div class="p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]">
            <span class="block text-neutral-500 mb-1">GitHub</span>
            <a
              href={profileData.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
            >
              github.com/oliverslater &nearr;
            </a>
          </div>
        )}

        <div class="p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]">
          <span class="block text-neutral-500 mb-1">Location</span>
          <span class="text-[var(--white)]">{profileData.location}</span>
        </div>

        <div class="p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]">
          <span class="block text-neutral-500 mb-1">LinkedIn</span>
          <a
            href={profileData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
          >
            in/oliverslater &nearr;
          </a>
        </div>
      </div>
    </header>

    <!-- Form Section -->
    <section>
      <ContactForm />
    </section>
  </div>
</BaseLayout>

<script>
  function recordContactReferrer() {
    if (document.referrer) {
      try {
        const ref = new URL(document.referrer);
        if (
          ref.origin === window.location.origin &&
          !ref.pathname.includes('/contact') &&
          !ref.pathname.includes('/thank-you')
        ) {
          sessionStorage.setItem('contact_referrer', ref.pathname + ref.search + ref.hash);
        }
      } catch {}
    }
  }
  recordContactReferrer();
  document.addEventListener('astro:after-swap', recordContactReferrer);
</script>
