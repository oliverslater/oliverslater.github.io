---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { profileData } from "../data/siteData";
import { getContactDetails } from "../utils/profile";

const { showEmail, contactEmail } = getContactDetails();
---

<Layout
  title={`Contact | ${profileData.name}`}
  description={`Get in touch with ${profileData.name} to discuss cloud architecture, ask technical questions, or exchange insights on platform engineering.`}
>
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-[#ffffff10]">
      <p class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
        Get in Touch
      </p>
      <h1 class="text-4xl sm:text-5xl font-medium tracking-tight text-[var(--white)] mb-3">
        Contact
      </h1>
      <p class="text-base text-[var(--white-icon)] leading-relaxed max-w-xl">
        While I'm not currently taking on consulting engagements, I'm always
        happy to share advice, answer architectural questions, or hear
        interesting engineering stories and tech news. Send a message below or
        connect via LinkedIn.
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        {showEmail && contactEmail ? (
          <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm">
            <span class="block text-neutral-500 mb-1">Direct Email</span>
            <a
              href={`mailto:${contactEmail}`}
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors break-all"
            >
              {contactEmail}
            </a>
          </div>
        ) : (
          <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm">
            <span class="block text-neutral-500 mb-1">GitHub</span>
            <a
              href={profileData.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
            >
              {profileData.github.replace("https://", "")} &nearr;
            </a>
          </div>
        )}

        <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm">
          <span class="block text-neutral-500 mb-1">Location</span>
          <span class="text-[var(--white)]">{profileData.location}</span>
        </div>

        <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm">
          <span class="block text-neutral-500 mb-1">LinkedIn</span>
          <a
            href={profileData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--white)] hover:text-[var(--sec)] transition-colors"
          >
            {profileData.linkedin
              .replace("https://www.", "")
              .replace("https://", "")}{" "}
            &nearr;
          </a>
        </div>
      </div>
    </header>

    <!-- Form Section -->
    <section>
      <ContactForm />
    </section>
  </div>
</Layout>

<script>
  function recordContactReferrer() {
    if (document.referrer) {
      try {
        const ref = new URL(document.referrer);
        if (
          ref.origin === window.location.origin &&
          !ref.pathname.includes("/contact") &&
          !ref.pathname.includes("/thank-you")
        ) {
          sessionStorage.setItem(
            "contact_referrer",
            ref.pathname + ref.search + ref.hash,
          );
        }
      } catch {}
    }
  }
  recordContactReferrer();
  document.addEventListener("astro:after-swap", recordContactReferrer);
</script>
