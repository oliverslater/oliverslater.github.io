---
import BaseLayout from '../layouts/BaseLayout.astro';
import profileData from '../content/cv/profile.json';
import experienceData from '../content/cv/experience.json';
import skillsData from '../content/cv/skills.json';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = blogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredRoles = experienceData.roles.slice(0, 2);
---

<BaseLayout
  title={`${profileData.name} | Cloud Architect`}
  description={profileData.bio}
>
  <!-- Hero Section -->
  <section class="mb-16 pt-4 sm:pt-8">
    <div class="space-y-4 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono bg-neutral-200/50 dark:bg-neutral-900 border border-neutral-300/60 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Available for cloud architecture & transformation advisory
      </div>

      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50 leading-tight">
        {profileData.name}
      </h1>

      <p class="text-lg sm:text-xl font-medium text-neutral-600 dark:text-neutral-300">
        {profileData.title}
      </p>

      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed pt-2">
        {profileData.bio}
      </p>

      <!-- Action buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-4 font-mono text-xs">
        <a
          href="/cv"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-950 font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
        >
          <span>View Scannable CV</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 hover:border-neutral-400 dark:hover:border-neutral-700 transition-colors"
        >
          Get in Touch
        </a>
        <a
          href={profileData.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
        >
          GitHub &nearr;
        </a>
      </div>
    </div>
  </section>

  <!-- Core Competencies / Specialization -->
  <section class="mb-16 pb-12 border-b border-neutral-200 dark:border-neutral-800">
    <div class="mb-6">
      <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
        Specialization & Architecture
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
      {
        profileData.coreCompetencies.map((competency) => (
          <div class="flex items-start gap-3 p-3.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-900/30">
            <span class="text-neutral-400 dark:text-neutral-600 font-mono text-sm mt-0.5">&bull;</span>
            <span class="text-sm font-medium text-neutral-800 dark:text-neutral-200">
              {competency}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Core Tech Stack Strip -->
    <div class="flex flex-wrap items-center gap-2 pt-2">
      <span class="text-xs font-mono text-neutral-500 mr-1">Primary Tools:</span>
      {
        skillsData.categories[0]?.skills.map((skill) => (
          <span class="px-2 py-0.5 rounded text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
            {skill}
          </span>
        ))
      }
    </div>
  </section>

  <!-- Selected Work Highlights -->
  <section class="mb-16 pb-12 border-b border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
          Recent Experience
        </h2>
        <p class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          Selected Highlights
        </p>
      </div>

      <a
        href="/cv"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors"
      >
        View Full History &rarr;
      </a>
    </div>

    <div class="space-y-8">
      {
        featuredRoles.map((role) => (
          <div class="group relative p-5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-900/40 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
                {role.role} <span class="text-neutral-400 font-normal">@</span>{' '}
                <span class="text-neutral-900 dark:text-neutral-100">{role.company}</span>
              </h3>
              <span class="font-mono text-xs text-neutral-500">
                {role.startDate} &mdash; {role.endDate}
              </span>
            </div>

            <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3 leading-relaxed">
              {role.description}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-1">
              {role.technologies.map((tech) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Recent Writing / Blog Posts -->
  {
    recentPosts.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-1">
              Engineering Notes
            </h2>
            <p class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
              Recent Articles
            </p>
          </div>

          <a
            href="/blog"
            class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors"
          >
            All Posts &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {recentPosts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col justify-between p-5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-900/40 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors"
            >
              <div>
                <time class="block font-mono text-xs text-neutral-500 mb-2">
                  {new Intl.DateTimeFormat('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  }).format(new Date(post.data.pubDate))}
                </time>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors mb-2">
                  {post.data.title}
                </h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="mt-4 flex items-center gap-1.5 font-mono text-xs text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-neutral-200 transition-colors">
                <span>Read article</span>
                <span aria-hidden="true">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
