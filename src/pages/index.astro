---
import Layout from "../layouts/Layout.astro";
import {
  deliverablesData,
  experienceData,
  profileData,
} from "../data/siteData";
import LogoWall from "../components/LogoWall.astro";
import LetterGlitch from "../components/LetterGlitch";
import SkillsList from "../components/SkillsList";
import Headshot from "../components/Headshot.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { formatDate } from "../utils/date";
import { getBlogUrl } from "../utils/blog";
import { getCollection } from "astro:content";

const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = blogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredRoles = experienceData.roles.slice(0, 2);
const titleParts = profileData.title.split(" ");
const titleFirst = titleParts[0];
const titleRest = titleParts.slice(1).join(" ");
---

<Layout
  title={`${profileData.name} | ${profileData.title}`}
  description={profileData.bio}
>
  <!-- Hero Section -->
  <section class="text-[var(--white)] pt-4 sm:pt-8 mb-16" id="home">
    <div class="space-y-6">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-5 sm:gap-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-neutral-100 dark:bg-[#1414149c] border border-neutral-200/80 dark:border-[var(--white-icon-tr)] text-[var(--white-icon)] shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] animate-pulse"></span>
            {profileData.headline}
          </div>

          <p class="text-base sm:text-lg text-[var(--white-icon)] shiny-white">
            Hi, I'm {profileData.name}
          </p>
        </div>

        <Headshot size="lg" />
      </div>
      <div class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 gap-4">
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-medium text-pretty leading-none text-[var(--white)] tracking-tight">
          {titleFirst} {titleRest && <br />} {titleRest}
        </h1>
        <p class="text-base sm:text-xl text-[var(--white-icon)] leading-relaxed max-w-xl">
          Specialising in enterprise-scale{" "}
          <span class="text-[var(--sec)] shiny-sec font-medium">
            cloud solutions
          </span>
          , serverless systems, and large-scale AWS & Azure transformations.
        </p>
      </div>
    </div>

    <!-- Social and quick action buttons -->
    <div class="flex flex-wrap items-center gap-3 pt-4">
      <SocialLinks variant="hero" />

      <a
        href="/cv"
        class="flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-sm font-medium text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition duration-300"
      >
        <span>View CV</span>
        <span class="text-[var(--sec)]">&rarr;</span>
      </a>

      <a
        href="/contact"
        class="flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--sec)] text-white dark:text-black font-semibold text-sm hover:opacity-90 transition duration-300"
      >
        <span>Get in Touch</span>
      </a>
    </div>
  </section>

  <!-- Logo Wall Marquee -->
  <LogoWall />

  <!-- Architecture Pillars & Interactive Canvas -->
  <section class="py-14 border-b border-[#ffffff10]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <SkillsList client:load pillars={deliverablesData.pillars} />
      </div>

      <div class="w-full h-[320px] sm:h-[380px] flex items-center justify-center">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </section>

  <!-- Work Experience / Highlights -->
  <section class="py-14 border-b border-[#ffffff10]" id="work">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
          Career Highlights
        </h2>
        <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] tracking-tight">
          Enterprise Experience
        </h3>
      </div>

      <a
        href="/cv"
        class="text-xs font-mono text-[var(--white-icon)] hover:text-[var(--white)] flex items-center gap-1.5 transition-colors"
      >
        <span>View Full CV</span>
        <span class="text-[var(--sec)]">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredRoles.map((role) => (
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] hover:border-neutral-300 dark:hover:border-[#ffffff25] shadow-sm transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-baseline justify-between gap-2 mb-2">
              <span class="text-xs font-mono text-[var(--sec)]">
                {role.startDate} &mdash; {role.endDate}
              </span>
              <span class="text-xs font-mono text-[var(--white-icon)]">
                {role.location}
              </span>
            </div>

            <h4 class="text-xl font-semibold text-[var(--white)] mb-1">
              {role.role}
            </h4>
            <p class="text-sm text-[var(--white-icon)] font-medium mb-3">
              {role.company}
            </p>

            <p class="text-xs sm:text-sm text-[var(--white-icon)] leading-relaxed mb-4">
              {role.description}
            </p>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-neutral-100 dark:border-[var(--white-icon-tr)]">
            {role.technologies.slice(0, 5).map((tech) => (
              <span class="tag-pill">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Engineering Notes / Blog -->
  {recentPosts.length > 0 && (
    <section class="py-14 border-b border-[#ffffff10]">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
            Engineering Notes
          </h2>
          <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] tracking-tight">
            Recent Articles
          </h3>
        </div>

        <a
          href="/blog"
          class="text-xs font-mono text-[var(--white-icon)] hover:text-[var(--white)] flex items-center gap-1.5 transition-colors"
        >
          <span>All Articles</span>
          <span class="text-[var(--sec)]">&rarr;</span>
        </a>
      </div>

      <div
        class:list={[
          "grid gap-6",
          recentPosts.length > 1 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1",
        ]}
      >
        {recentPosts.map((post) => (
          <a
            href={getBlogUrl(post)}
            class="p-6 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] hover:border-neutral-300 dark:hover:border-[#ffffff25] shadow-sm transition-all duration-300 flex flex-col justify-between group"
          >
            <div>
              <time class="block text-xs font-mono text-[var(--sec)] mb-2">
                {formatDate(post.data.pubDate)}
              </time>
              <h4 class="text-lg font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors mb-2">
                {post.data.title}
              </h4>
              <p class="text-xs sm:text-sm text-[var(--white-icon)] line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="mt-4 pt-3 flex items-center justify-between border-t border-[var(--white-icon-tr)] text-xs font-mono text-[var(--white-icon)]">
              <span>Read article</span>
              <span class="text-[var(--sec)]">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact Section / Call to Action -->
  <section class="py-14" id="contact">
    <div class="p-8 sm:p-12 rounded-3xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm relative overflow-hidden">
      <div class="max-w-2xl">
        <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
          Get in Touch
        </h2>
        <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] mb-4 tracking-tight">
          Ready to Modernise Your Cloud Architecture?
        </h3>
        <p class="text-sm sm:text-base text-[var(--white-icon)] leading-relaxed mb-8">
          Have an architecture project, consulting inquiry, or cloud
          transformation initiative? Get in touch to discuss your goals.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[var(--sec)] text-white dark:text-black font-semibold text-sm hover:opacity-90 shadow-md transition duration-300"
          >
            <span>Get in Touch</span>
            <span>&rarr;</span>
          </a>
          <a
            href="/cv"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-sm font-medium text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition duration-300"
          >
            <span>View Full CV</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
