---
import BaseLayout from '../layouts/BaseLayout.astro';
import profileData from '../content/cv/profile.json';
import experienceData from '../content/cv/experience.json';
import LogoWall from '../components/LogoWall.astro';
import LetterGlitch from '../components/LetterGlitch';
import SkillsList from '../components/SkillsList';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = blogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const featuredRoles = experienceData.roles.slice(0, 2);
---

<BaseLayout
  title={`${profileData.name} | Cloud Architect`}
  description={profileData.bio}
>
  <!-- Hero Section -->
  <section class="text-[var(--white)] pt-4 sm:pt-8 mb-16" id="home">
    <div class="space-y-6">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-5 sm:gap-8">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-neutral-100 dark:bg-[#1414149c] border border-neutral-200/80 dark:border-[var(--white-icon-tr)] text-[var(--white-icon)] shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] animate-pulse"></span>
            AWS Golden Jacket Holder &middot; 11x AWS Certified
          </div>

          <p class="text-base sm:text-lg text-[var(--white-icon)] shiny-white">
            Hi, I'm Oliver Slater
          </p>
        </div>

        <div class="flex-shrink-0">
          <picture>
            <source
              type="image/webp"
              srcset="/assets/oliver-slater-128.webp 128w, /assets/oliver-slater-256.webp 256w, /assets/oliver-slater-384.webp 384w"
              sizes="(max-width: 640px) 80px, (max-width: 768px) 96px, 112px"
            />
            <source
              type="image/png"
              srcset="/assets/oliver-slater-128.png 128w, /assets/oliver-slater-256.png 256w, /assets/oliver-slater-384.png 384w"
              sizes="(max-width: 640px) 80px, (max-width: 768px) 96px, 112px"
            />
            <img
              src="/assets/oliver-slater-256.png"
              alt="Oliver Slater - Cloud Architect"
              class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-2xl sm:rounded-3xl object-cover border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm"
              width="112"
              height="112"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
        <div class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 gap-4">
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-medium text-pretty leading-none text-[var(--white)] tracking-tight">
            Cloud <br /> Architect
          </h1>
          <p class="text-base sm:text-xl text-[var(--white-icon)] leading-relaxed max-w-xl">
            Specialising in enterprise-scale <span class="text-[var(--sec)] shiny-sec font-medium">cloud solutions</span>, serverless systems, and large-scale AWS & Azure transformations.
          </p>
        </div>
      </div>

      <!-- Social and quick action buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-4">
        <a
          href="https://github.com/oliverslater"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out border border-neutral-200/80 dark:border-[var(--white-icon-tr)] p-3 rounded-xl bg-white dark:bg-[#1414149c] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
          </svg>
        </a>

        <a
          href="https://linkedin.com/in/oliverslater"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out border border-neutral-200/80 dark:border-[var(--white-icon-tr)] p-3 rounded-xl bg-white dark:bg-[#1414149c] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z" />
          </svg>
        </a>

        <a
          href="/cv"
          class="flex items-center gap-2 px-5 py-3 rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-sm font-medium text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition duration-300"
        >
          <span>View Scannable CV</span>
          <span class="text-[var(--sec)]">&rarr;</span>
        </a>

        <a
          href="/contact"
          class="flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--sec)] text-black font-medium text-sm hover:opacity-90 transition duration-300"
        >
          <span>Let's Talk</span>
        </a>
      </div>
  </section>

  <!-- Logo Wall Marquee -->
  <LogoWall />

  <!-- Architecture Pillars & Interactive Canvas -->
  <section class="py-14 border-b border-[#ffffff10]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <SkillsList client:load />
      </div>

      <div class="w-full h-[320px] sm:h-[380px] flex items-center justify-center">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </section>

  <!-- Work Experience / Highlights -->
  <section class="py-14 border-b border-[#ffffff10]" id="work">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
          Career Highlights
        </h2>
        <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] tracking-tight">
          Enterprise Experience
        </h3>
      </div>

      <a
        href="/cv"
        class="text-xs font-mono text-[var(--white-icon)] hover:text-[var(--white)] flex items-center gap-1.5 transition-colors"
      >
        <span>Full CV</span>
        <span class="text-[var(--sec)]">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        featuredRoles.map((role) => (
          <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] hover:border-neutral-300 dark:hover:border-[#ffffff25] shadow-sm transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <span class="text-xs font-mono text-[var(--sec)]">
                  {role.startDate} &mdash; {role.endDate}
                </span>
                <span class="text-xs font-mono text-[var(--white-icon)]">
                  {role.location}
                </span>
              </div>

              <h4 class="text-xl font-semibold text-[var(--white)] mb-1">
                {role.role}
              </h4>
              <p class="text-sm text-[var(--white-icon)] font-medium mb-3">
                {role.company}
              </p>

              <p class="text-xs sm:text-sm text-[var(--white-icon)] leading-relaxed mb-4">
                {role.description}
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-neutral-100 dark:border-[var(--white-icon-tr)]">
              {role.technologies.slice(0, 5).map((tech) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-neutral-100 dark:bg-[#ffffff08] text-neutral-600 dark:text-[var(--white-icon)] border border-neutral-200/80 dark:border-[#ffffff10]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Engineering Notes / Blog -->
  {
    recentPosts.length > 0 && (
      <section class="py-14 border-b border-[#ffffff10]">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
              Engineering Notes
            </h2>
            <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] tracking-tight">
              Recent Articles
            </h3>
          </div>

          <a
            href="/blog"
            class="text-xs font-mono text-[var(--white-icon)] hover:text-[var(--white)] flex items-center gap-1.5 transition-colors"
          >
            <span>All Articles</span>
            <span class="text-[var(--sec)]">&rarr;</span>
          </a>
        </div>

        <div class:list={['grid gap-6', recentPosts.length > 1 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1']}>
          {recentPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="p-6 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] hover:border-neutral-300 dark:hover:border-[#ffffff25] shadow-sm transition-all duration-300 flex flex-col justify-between group"
            >
              <div>
                <time class="block text-xs font-mono text-[var(--sec)] mb-2">
                  {new Intl.DateTimeFormat('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  }).format(new Date(post.data.pubDate))}
                </time>
                <h4 class="text-lg font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors mb-2">
                  {post.data.title}
                </h4>
                <p class="text-xs sm:text-sm text-[var(--white-icon)] line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="mt-4 pt-3 flex items-center justify-between border-t border-[var(--white-icon-tr)] text-xs font-mono text-[var(--white-icon)]">
                <span>Read article</span>
                <span class="text-[var(--sec)]">&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Contact Section -->
  <section class="py-14" id="contact">
    <div class="max-w-2xl">
      <h2 class="text-sm font-medium text-[var(--sec)] shiny-sec mb-1">
        Let's Talk
      </h2>
      <h3 class="text-3xl sm:text-4xl font-semibold text-[var(--white)] mb-4 tracking-tight">
        Get in Touch
      </h3>
      <p class="text-sm text-[var(--white-icon)] leading-relaxed mb-8">
        Have an architecture project, consulting inquiry, or cloud transformation initiative? Send a message directly below.
      </p>

      <ContactForm />
    </div>
  </section>
</BaseLayout>
