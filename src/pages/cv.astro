---
import Layout from "../layouts/Layout.astro";
import CVSection from "../components/CVSection.astro";
import Headshot from "../components/Headshot.astro";
import profileData from "../content/cv/profile.json";
import experienceData from "../content/cv/experience.json";
import skillsData from "../content/cv/skills.json";
import { getAllCredentials } from "../utils/certifications";
import { getContactDetails } from "../utils/profile";
import { calculateTotalExperienceYears } from "../utils/date";

const allBadges = await getAllCredentials();
const displayedBadges = allBadges.filter((b) => b.displayed);
const countedBadges = allBadges.filter((b) => b.includeInCount);
const totalCount = countedBadges.length;
const { showEmail, contactEmail } = getContactDetails();
const totalExperienceYears = calculateTotalExperienceYears(
  experienceData.roles,
);
---

<Layout
  title={`CV & Resume | ${profileData.name}`}
  description={`Scannable curriculum vitae of ${profileData.name} - ${profileData.title}. Detailed work history, system architecture experience, and skill set.`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Top Action Bar (Print & Contact) -->
    <div class="no-print flex items-center justify-between pb-6 mb-8 border-b border-[#ffffff10]">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
      >
        <span>&larr;</span> Back to Overview
      </a>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition-colors"
        >
          <svg
            class="w-3.5 h-3.5 text-[var(--sec)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print / PDF
        </button>

        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-medium bg-[var(--sec)] text-black hover:opacity-90 transition-colors"
        >
          Contact Me
        </a>
      </div>
    </div>

    <!-- CV Header -->
    <header class="mb-14 pb-8 print:mb-6 print:pb-4 border-b border-[#ffffff10] print:border-neutral-300">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-2 print:space-y-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-purple-50 dark:bg-[#1414149c] print:!bg-neutral-100 border border-purple-200/60 dark:border-[var(--white-icon-tr)] print:!border-neutral-300 text-[var(--sec)] print:!text-neutral-800 mb-2 shadow-sm print:shadow-none">
            <span class="w-2 h-2 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] print:bg-purple-600"></span>
            AWS Golden Jacket Holder &middot; 11x AWS Certified
          </div>
          <h1 class="text-4xl sm:text-5xl print:text-3xl font-medium tracking-tight text-[var(--white)] print:!text-black">
            {profileData.name}
          </h1>
          <p class="text-xl print:text-base text-[var(--white-icon)] print:!text-neutral-700 font-medium">
            {profileData.title}
          </p>
        </div>

        <Headshot size="md" />
      </div>

      <!-- Contact and links grid -->
      <div class="mt-6 print:mt-3 flex flex-wrap items-center gap-x-6 print:gap-x-5 gap-y-2 text-xs font-mono text-[var(--white-icon)] print:!text-neutral-700">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            Location:
          </span>
          <span class="text-[var(--white)] print:!text-black">
            {profileData.location}
          </span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            {showEmail && contactEmail ? "Email:" : "Contact:"}
          </span>
          {showEmail && contactEmail ? (
            <a
              href={`mailto:${contactEmail}`}
              class="hover:text-[var(--sec)] transition-colors print:!text-black"
            >
              {contactEmail}
            </a>
          ) : (
            <a
              href="/contact"
              class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-[var(--sec)]/10 border border-[var(--sec)]/30 text-[var(--sec)] print:p-0 print:border-none print:!text-black font-mono text-[11px]"
            >
              <span class="print:hidden">Contact Form &nearr;</span>
              <span class="hidden print:inline font-mono">
                oliver-slater.co.uk/contact
              </span>
            </a>
          )}
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            Web:
          </span>
          <a
            href={profileData.website}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black"
          >
            {profileData.website.replace("https://", "")}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            GitHub:
          </span>
          <a
            href={profileData.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black"
          >
            github.com/oliverslater
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            LinkedIn:
          </span>
          <a
            href={profileData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black"
          >
            in/oliverslater
          </a>
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <CVSection title="Professional Summary">
      <div class="p-6 print:p-4 rounded-2xl print:rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:!border-neutral-300 bg-white dark:bg-[#1414149c] print:!bg-white shadow-sm print:shadow-none leading-relaxed text-sm print:text-xs text-[var(--white-icon)] print:!text-neutral-800 whitespace-pre-line print-break-inside-avoid">
        {profileData.bio}
      </div>
    </CVSection>

    <!-- Work Experience -->
    <CVSection
      title="Work Experience"
      badge={`${totalExperienceYears}+ years experience`}
    >
      <div class="relative border-l border-neutral-300 dark:border-[#ffffff15] print:border-neutral-300 ml-12 sm:ml-16 print:ml-10 space-y-12 print:space-y-4 pl-6 sm:pl-8 print:pl-4">
        {experienceData.roles.map((role) => {
          const startYear = role.startDate.split(" ")[1] || role.startDate;
          return (
            <div class="relative print-break-inside-avoid">
              <!-- Timeline node marker with year milestone -->
              <div class="absolute -left-[31px] sm:-left-[39px] print:-left-[23px] top-1.5 flex items-center">
                <span class="w-3 h-3 rounded-full border-2 border-[var(--background)] print:border-white bg-[var(--sec)] print:bg-neutral-800 shadow-sm shrink-0" />
                <span class="absolute right-5 font-mono text-xs print:text-[10px] font-semibold text-[var(--sec)] print:!text-neutral-700 select-none whitespace-nowrap text-right">
                  {startYear}
                </span>
              </div>

              <div class="p-6 print:p-4 rounded-2xl print:rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:!border-neutral-300 bg-white dark:bg-[#1414149c] print:!bg-white hover:border-neutral-300 dark:hover:border-[#ffffff20] shadow-sm print:shadow-none transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2 print:mb-1">
                  <div>
                    <h3 class="text-lg print:text-sm font-semibold text-[var(--white)] print:!text-black">
                      {role.role}
                    </h3>
                    <div class="text-sm print:text-xs text-[var(--white-icon)] print:!text-neutral-700 font-medium">
                      <span class="font-semibold print:!text-black">
                        {role.company}
                      </span>
                      {role.location && (
                        <span class="text-neutral-500 print:!text-neutral-600">
                          {" "}
                          &middot; {role.location}
                        </span>
                      )}
                    </div>
                  </div>

                  <div class="font-mono text-xs print:text-[11px] text-[var(--sec)] print:!text-neutral-700 whitespace-nowrap font-medium">
                    <span>{role.startDate}</span> &mdash;{" "}
                    <span
                      class={
                        role.current
                          ? "text-[#16a34a] dark:text-[#A9FF5B] print:!text-black font-semibold"
                          : ""
                      }
                    >
                      {role.endDate}
                    </span>
                  </div>
                </div>

                <p class="text-sm print:text-xs text-[var(--white-icon)] print:!text-neutral-800 mt-3 print:mt-1 mb-4 print:mb-2 leading-relaxed">
                  {role.description}
                </p>

                {role.highlights && role.highlights.length > 0 && (
                  <ul class="space-y-2 print:space-y-1 mb-5 print:mb-2">
                    {role.highlights.map((highlight) => (
                      <li class="flex items-start text-xs sm:text-sm print:text-xs text-[var(--white-icon)] print:!text-neutral-800 leading-relaxed">
                        <span class="mr-2 text-[var(--sec)] print:!text-neutral-500 font-mono">
                          &bull;
                        </span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {role.technologies && (
                  <div class="flex flex-wrap gap-1.5 pt-3 print:pt-1.5 border-t border-neutral-100 dark:border-[var(--white-icon-tr)] print:!border-neutral-200">
                    {role.technologies.map((tech) => (
                      <span class="px-2 py-0.5 rounded text-[11px] print:text-[10px] font-mono bg-neutral-100 dark:bg-[#ffffff08] print:!bg-neutral-100 text-neutral-600 dark:text-[var(--white-icon)] print:!text-neutral-800 border border-neutral-200/80 dark:border-[#ffffff10] print:!border-neutral-300">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </CVSection>

    <!-- Technical Skills Matrix -->
    <CVSection title="Technical Capabilities & Tooling">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 print:gap-2.5">
        {skillsData.categories.map((category) => (
          <div class="p-5 print:p-3 rounded-2xl print:rounded-xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:!border-neutral-300 bg-white dark:bg-[#1414149c] print:!bg-white shadow-sm print:shadow-none print-break-inside-avoid">
            <h3 class="font-mono text-xs print:text-[11px] font-semibold text-[var(--sec)] print:!text-neutral-900 uppercase tracking-wider mb-3 print:mb-1.5">
              {category.category}
            </h3>
            <div class="flex flex-wrap gap-1.5 print:gap-1">
              {category.skills.map((skill) => (
                <span class="px-2 py-0.5 rounded text-xs print:text-[10px] font-mono bg-neutral-100 dark:bg-[#ffffff08] print:!bg-neutral-100 text-neutral-600 dark:text-[var(--white-icon)] print:!text-neutral-800 border border-neutral-200/80 dark:border-[#ffffff10] print:!border-neutral-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </CVSection>

    <!-- Education & Professional Qualifications -->
    <CVSection
      title="Education & Verified Credentials"
      badge={`${totalCount} verified credentials`}
    >
      <div class="mb-4 print:mb-2 flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--white-icon)] print:text-neutral-600">
        <span>Verified via Credly & Microsoft Learn</span>
        <div class="flex items-center gap-3 print:hidden">
          <a
            href="https://www.credly.com/users/oliver-slater"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--sec)] hover:underline flex items-center gap-1"
          >
            Credly Profile &nearr;
          </a>
          <span>&middot;</span>
          <a
            href="https://learn.microsoft.com/en-gb/users/oliverslater/transcript/d5on2cqnl3lgknq"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--sec)] hover:underline flex items-center gap-1"
          >
            MS Learn &nearr;
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 print:grid-cols-2 gap-4 print:gap-2">
        {displayedBadges.map((cert) => (
          <div class="p-4 print:p-2 rounded-2xl print:rounded-lg border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:!border-neutral-300 bg-white dark:bg-[#1414149c] print:!bg-white flex items-start gap-3.5 print:gap-2 hover:border-neutral-300 dark:hover:border-[#ffffff20] shadow-sm print:shadow-none transition-colors group print-break-inside-avoid">
            {cert.imageUrl ? (
              <img
                src={cert.imageUrl}
                alt={cert.title}
                class="w-12 h-12 print:w-8 print:h-8 object-contain flex-shrink-0 group-hover:scale-105 transition-transform"
                loading="lazy"
                width="48"
                height="48"
              />
            ) : (
              <div class="w-12 h-12 print:w-8 print:h-8 rounded-xl bg-neutral-100 dark:bg-[#ffffff08] print:!bg-neutral-100 flex items-center justify-center text-[var(--sec)] flex-shrink-0 text-sm">
                ⚡
              </div>
            )}
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between gap-1 mb-1 print:mb-0.5">
                <span class="px-2 py-0.5 rounded-full text-[10px] print:text-[8px] font-mono uppercase tracking-wider bg-purple-50 dark:bg-[#ffffff08] print:!bg-neutral-100 text-[var(--sec)] print:!text-neutral-700 border border-purple-200/60 dark:border-[#ffffff10] print:!border-neutral-300">
                  {cert.issuer}
                </span>
                <span class="text-[11px] print:text-[9px] font-mono text-neutral-500 print:!text-neutral-600 whitespace-nowrap">
                  {cert.issueDate}
                </span>
              </div>
              <h3 class="text-sm print:text-[11px] font-semibold text-[var(--white)] print:!text-neutral-900 leading-snug line-clamp-2">
                {cert.title}
              </h3>
              <div class="mt-2.5 print:mt-0.5 flex items-center justify-between text-xs print:text-[9px] font-mono">
                {cert.expiresDate ? (
                  <span class="text-[11px] print:text-[9px] text-neutral-500 print:!text-neutral-600">
                    Exp: {cert.expiresDate}
                  </span>
                ) : (
                  <span class="text-[11px] print:text-[9px] text-[#16a34a] dark:text-[#A9FF5B] print:!text-neutral-700 font-medium">
                    Active
                  </span>
                )}
                <span class="print:hidden">
                  <a
                    href={cert.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--sec)] hover:underline text-[11px] inline-flex items-center gap-0.5"
                  >
                    Verify &nearr;
                  </a>
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </CVSection>

    <!-- References Notice -->
    <div class="text-center py-8 print:py-4 border-t border-[#ffffff10] print:border-neutral-300 font-mono text-xs text-[var(--white-icon)] print:text-neutral-600 print-break-inside-avoid">
      References available on request
    </div>
  </div>
</Layout>
