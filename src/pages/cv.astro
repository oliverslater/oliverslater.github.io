---
import Layout from "../layouts/Layout.astro";
import CVSection from "../components/CVSection.astro";
import Headshot from "../components/Headshot.astro";
import TechPill from "../components/TechPill.astro";
import {
  cvPdfFilename,
  cvPdfPath,
  experienceData,
  profileData,
  skillsData,
} from "../data/siteData";
import { getAllCredentials } from "../utils/certifications";
import { isCredentialExpired } from "../utils/credentialTypes";
import { getContactDetails } from "../utils/profile";
import { calculateTotalExperienceYears } from "../utils/date";
import { getProfilePageSchema } from "../utils/schema";

const allBadges = await getAllCredentials();
const displayedBadges = allBadges.filter((b) => b.displayed);
const countedBadges = allBadges.filter((b) => b.includeInCount);
const totalCount = countedBadges.length;
const { showEmail, contactEmail } = getContactDetails();
const totalExperienceYears = calculateTotalExperienceYears(
  experienceData.roles,
);

const cvSchema = getProfilePageSchema({
  path: "/cv/",
  name: `CV & Resume | ${profileData.name}`,
  siteUrl: Astro.site,
});
---

<Layout
  title={`CV & Resume | ${profileData.name}`}
  description={`Professional CV of ${profileData.name}, AWS Golden Jacket holder and ${profileData.title}. Detailed work history, certifications, and technical architecture expertise.`}
  schema={cvSchema}
>
  <div class="max-w-4xl mx-auto">
    <!-- Top Action Bar (Print & Direct PDF Download) -->
    <div class="no-print flex flex-wrap items-center justify-between gap-3 pb-6 mb-8 border-b border-[#ffffff10]">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--white-icon)] hover:text-[var(--white)] transition-colors"
      >
        <span>&larr;</span> Back to Overview
      </a>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          type="button"
          id="cv-print-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition-colors cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5 text-[var(--sec)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="14"
            height="14"
            aria-hidden="true"
          >
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Print / PDF</span>
        </button>

        <a
          href={cvPdfPath}
          download={cvPdfFilename}
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] text-[var(--white)] hover:bg-neutral-100 dark:hover:bg-[var(--white-icon-tr)] shadow-sm transition-colors"
          aria-label={`Download ${profileData.name} CV as PDF directly`}
        >
          <svg
            class="w-3.5 h-3.5 text-[var(--sec)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="14"
            height="14"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF</span>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-semibold bg-[var(--sec)] text-white dark:text-black hover:opacity-90 transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>

    <!-- Fallback Print Dialog -->
    <dialog
      id="print-fallback-dialog"
      class="backdrop:bg-black/60 p-6 rounded-2xl bg-white dark:bg-[#18181b] text-[var(--white)] border border-neutral-200 dark:border-[var(--white-icon-tr)] shadow-2xl max-w-sm mx-auto my-auto"
    >
      <h3 class="text-base font-semibold mb-2">Print to PDF</h3>
      <p class="text-xs text-[var(--white-icon)] leading-relaxed mb-4">
        To save as a clean PDF, open your browser's print dialog (
        <kbd class="px-1.5 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 font-mono">
          Cmd + P
        </kbd>{" "}
        on Mac or{" "}
        <kbd class="px-1.5 py-0.5 rounded border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 font-mono">
          Ctrl + P
        </kbd>{" "}
        on Windows) and select <strong>Save as PDF</strong> as the destination.
      </p>
      <button
        type="button"
        id="close-print-dialog"
        class="w-full py-2 rounded-xl text-xs font-semibold bg-[var(--sec)] text-white dark:text-black hover:opacity-90 transition-opacity"
      >
        Understood
      </button>
    </dialog>

    <!-- CV Header -->
    <header class="mb-14 pb-8 print:mb-4 print:pb-3 border-b border-[#ffffff10] print:border-neutral-300">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-2 print:space-y-0.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-purple-50 dark:bg-[#1414149c] print:!bg-transparent border border-purple-200/60 dark:border-[var(--white-icon-tr)] print:border-none text-[var(--sec)] print:!text-neutral-700 mb-2 print:mb-0.5 shadow-sm print:shadow-none print:p-0 font-medium">
            <span class="w-2 h-2 rounded-full bg-[#16a34a] dark:bg-[#A9FF5B] print:hidden"></span>
            {profileData.headline}
          </div>
          <h1 class="text-4xl sm:text-5xl print:text-2xl font-medium tracking-tight text-[var(--white)] print:!text-black">
            {profileData.name}
          </h1>
          <p class="text-xl print:text-sm text-[var(--white-icon)] print:!text-neutral-700 font-medium">
            {profileData.title}
          </p>
        </div>

        <Headshot size="md" />
      </div>

      <!-- Contact and links grid -->
      <div class="mt-6 print:mt-2 flex flex-wrap items-center gap-x-6 print:gap-x-4 gap-y-2 print:gap-y-1 text-xs print:text-[10px] font-mono text-[var(--white-icon)] print:!text-neutral-700">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            Location:
          </span>
          <span class="text-[var(--white)] print:!text-black">
            {profileData.location}
          </span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            {showEmail && contactEmail ? "Email:" : "Contact:"}
          </span>
          {showEmail && contactEmail ? (
            <a
              href={`mailto:${contactEmail}`}
              class="hover:text-[var(--sec)] transition-colors print:!text-black no-print-url"
            >
              {contactEmail}
            </a>
          ) : (
            <a
              href="/contact"
              class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-[var(--sec)]/10 border border-[var(--sec)]/30 text-[var(--sec)] print:p-0 print:border-none print:!text-black font-mono text-[11px] print:text-[10px] no-print-url"
            >
              <span class="print:hidden">Get in Touch &nearr;</span>
              <span class="hidden print:inline font-mono">
                {profileData.website
                  .replace("https://www.", "")
                  .replace("https://", "")}
                /contact
              </span>
            </a>
          )}
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            Web:
          </span>
          <a
            href={profileData.website}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black no-print-url"
          >
            {profileData.website.replace("https://", "")}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            GitHub:
          </span>
          <a
            href={profileData.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black no-print-url"
          >
            {profileData.github.replace("https://", "")}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500 print:!text-neutral-800 font-semibold">
            LinkedIn:
          </span>
          <a
            href={profileData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--sec)] transition-colors print:!text-black no-print-url"
          >
            {profileData.linkedin
              .replace("https://www.", "")
              .replace("https://", "")}
          </a>
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <CVSection title="Professional Summary">
      <div class="p-6 print:p-0 rounded-2xl print:rounded-none border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:border-none bg-white dark:bg-[#1414149c] print:!bg-transparent shadow-sm print:shadow-none leading-relaxed text-sm print:text-[10.5px] print:leading-relaxed text-[var(--white-icon)] print:!text-neutral-800 whitespace-pre-line print-break-inside-avoid">
        {profileData.bio}
      </div>
    </CVSection>

    <!-- Work Experience -->
    <CVSection
      title="Work Experience"
      badge={`${totalExperienceYears}+ years experience`}
    >
      <div class="relative border-l border-neutral-300 dark:border-[#ffffff15] print:border-l-0 ml-12 sm:ml-16 print:ml-0 space-y-12 print:space-y-4 pl-6 sm:pl-8 print:pl-0">
        {experienceData.roles.map((role) => {
          const startYear = role.startDate.split(" ")[1] || role.startDate;
          return (
            <div class="relative print-break-inside-avoid print:pb-3.5 print:border-b print:border-neutral-200/60 last:print:border-b-0">
              <!-- Timeline node marker with year milestone (Screen Only) -->
              <div class="absolute -left-[31px] sm:-left-[39px] print:hidden top-1.5 flex items-center">
                <span class="w-3 h-3 rounded-full border-2 border-[var(--background)] bg-[var(--sec)] shadow-sm shrink-0" />
                <span class="absolute right-5 font-mono text-xs font-semibold text-[var(--sec)] select-none whitespace-nowrap text-right">
                  {startYear}
                </span>
              </div>

              <div class="p-6 print:p-0 rounded-2xl print:rounded-none border border-neutral-200/80 dark:border-[var(--white-icon-tr)] print:border-none bg-white dark:bg-[#1414149c] print:!bg-transparent hover:border-neutral-300 dark:hover:border-[#ffffff20] shadow-sm print:shadow-none transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2 print:mb-0.5">
                  <div>
                    <h3 class="text-lg print:text-[12.5px] font-semibold text-[var(--white)] print:!text-black">
                      {role.role}
                    </h3>
                    <div class="text-sm print:text-[10.5px] text-[var(--white-icon)] print:!text-neutral-700 font-medium">
                      <span class="font-semibold print:!text-black">
                        {role.company}
                      </span>
                      {role.location && (
                        <span class="text-neutral-500 print:!text-neutral-600">
                          {" "}
                          &middot; {role.location}
                        </span>
                      )}
                    </div>
                  </div>

                  <div class="font-mono text-xs print:text-[10px] text-[var(--sec)] print:!text-neutral-700 whitespace-nowrap font-medium">
                    <span>{role.startDate}</span> &mdash;{" "}
                    <span
                      class={
                        role.current
                          ? "text-[#16a34a] dark:text-[#A9FF5B] print:!text-black font-semibold"
                          : ""
                      }
                    >
                      {role.endDate}
                    </span>
                  </div>
                </div>

                <p class="text-sm print:text-[10.5px] text-[var(--white-icon)] print:!text-neutral-800 mt-3 print:mt-1 mb-4 print:mb-1.5 leading-relaxed print:leading-normal">
                  {role.description}
                </p>

                {role.highlights && role.highlights.length > 0 && (
                  <ul class="space-y-2 print:space-y-0.5 mb-5 print:mb-2">
                    {role.highlights.map((highlight) => (
                      <li class="flex items-start text-xs sm:text-sm print:text-[10px] text-[var(--white-icon)] print:!text-neutral-800 leading-relaxed print:leading-normal">
                        <span class="mr-2 print:mr-1.5 text-[var(--sec)] print:!text-neutral-500 font-mono select-none">
                          &bull;
                        </span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {role.technologies && (
                  <>
                    <!-- Screen View: Pill Badges -->
                    <div class="flex flex-wrap gap-1.5 pt-3 border-t border-neutral-100 dark:border-[var(--white-icon-tr)] print:hidden">
                      {role.technologies.map((tech) => (
                        <TechPill name={tech} />
                      ))}
                    </div>

                    <!-- Print View: Space-efficient inline list (No pill boxes) -->
                    <div class="hidden print:block pt-1 text-[9.5px] font-mono text-neutral-600 print:!text-neutral-700 leading-tight">
                      <span class="font-semibold text-neutral-900">
                        Key Technologies:
                      </span>{" "}
                      {role.technologies.join(" · ")}
                    </div>
                  </>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </CVSection>

    <!-- Technical Skills Matrix -->
    <CVSection title="Technical Capabilities & Tooling">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 print:gap-x-8 print:gap-y-4">
        {skillsData.categories.map((category) => (
          <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] shadow-sm hover:border-neutral-300 dark:hover:border-[#ffffff20] transition-colors print:p-0 print:border-none print:shadow-none print:bg-transparent print-break-inside-avoid">
            <h3 class="font-mono text-xs font-semibold text-[var(--sec)] uppercase tracking-wider mb-3 print:text-[11px] print:!text-neutral-900 print:mb-1.5">
              {category.category}
            </h3>

            <!-- Screen View: Interactive Tag Cards -->
            <div class="flex flex-wrap gap-1.5 print:hidden">
              {category.skills.map((skill) => (
                <TechPill name={skill} />
              ))}
            </div>

            <!-- Print View: Clean Bulleted Lists (No boxes) -->
            <ul class="hidden print:block space-y-0.5">
              {category.skills.map((skill) => (
                <li class="flex items-start text-[10.5px] text-neutral-800 leading-snug">
                  <span class="mr-1.5 text-neutral-500 font-mono select-none flex-shrink-0">
                    &bull;
                  </span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </CVSection>

    <!-- Education & Professional Qualifications -->
    <CVSection
      title="Education & Verified Credentials"
      badge={`${totalCount} verified credentials`}
    >
      <div class="mb-4 print:mb-1.5 flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--white-icon)] print:text-neutral-600">
        <span>Verified via Credly & Microsoft Learn</span>
        <div class="flex items-center gap-3 print:hidden">
          {profileData.credly && (
            <a
              href={profileData.credly}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--sec)] hover:underline flex items-center gap-1"
            >
              Credly Profile &nearr;
            </a>
          )}
          {profileData.credly && profileData.mslearn && <span>&middot;</span>}
          {profileData.mslearn && (
            <a
              href={profileData.mslearn}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--sec)] hover:underline flex items-center gap-1"
            >
              MS Learn &nearr;
            </a>
          )}
        </div>
        {profileData.credly && (
          <span class="hidden print:inline text-[9.5px] text-neutral-500 font-mono">
            {profileData.credly
              .replace("https://www.", "")
              .replace("https://", "")}
          </span>
        )}
      </div>

      <!-- Screen View: Credential Cards with Badges -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 print:hidden">
        {displayedBadges.map((cert) => {
          const isExpired = isCredentialExpired(
            cert.rawExpiresDate,
            cert.expiresDate,
          );
          return (
            <div class="relative group/card p-4 rounded-2xl border border-neutral-200/80 dark:border-[var(--white-icon-tr)] bg-white dark:bg-[#1414149c] flex items-start gap-3.5 hover:border-neutral-300 dark:hover:border-[#ffffff20] shadow-sm transition-colors print-break-inside-avoid">
              <!-- Micro-tooltip indicating credential details on hover/focus -->
              <div
                role="tooltip"
                class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 px-2.5 py-1 rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 text-[10.5px] font-mono whitespace-nowrap opacity-0 group-hover/card:opacity-100 group-focus-within/card:opacity-100 transition-opacity shadow-lg z-20"
              >
                Issued: {cert.issueDate}{" "}
                {cert.expiresDate ? `· Exp: ${cert.expiresDate}` : "· Active"}
              </div>

              {cert.imageUrl ? (
                <img
                  src={cert.imageUrl}
                  alt={cert.title}
                  class="w-12 h-12 object-contain flex-shrink-0 group-hover/card:scale-105 transition-transform"
                  loading="lazy"
                  width="48"
                  height="48"
                />
              ) : (
                <div class="w-12 h-12 rounded-xl bg-neutral-100 dark:bg-[#ffffff08] flex items-center justify-center text-[var(--sec)] flex-shrink-0 text-sm">
                  ⚡
                </div>
              )}
              <div class="flex-grow min-w-0">
                <div class="flex items-center justify-between gap-1 mb-1">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider bg-purple-50 dark:bg-[#ffffff08] text-[var(--sec)] border border-purple-200/60 dark:border-[#ffffff10]">
                    {cert.issuer}
                  </span>
                  <span class="text-[11px] font-mono text-neutral-500 whitespace-nowrap">
                    {cert.issueDate}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-[var(--white)] leading-snug line-clamp-2">
                  {cert.title}
                </h3>
                <div class="mt-2.5 flex items-center justify-between text-xs font-mono">
                  {isExpired ? (
                    <span class="text-[11px] text-neutral-500">
                      Expired{cert.expiresDate ? `: ${cert.expiresDate}` : ""}
                    </span>
                  ) : (
                    <div class="flex items-center flex-wrap gap-x-1.5 gap-y-0.5 text-[11px]">
                      <span class="text-[#16a34a] dark:text-[#A9FF5B] font-medium">
                        Active
                      </span>
                      {cert.expiresDate && (
                        <>
                          <span class="text-neutral-400 dark:text-neutral-600">
                            ·
                          </span>
                          <span class="text-neutral-500">
                            Exp: {cert.expiresDate}
                          </span>
                        </>
                      )}
                    </div>
                  )}
                  <span>
                    <a
                      href={cert.verifyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--sec)] hover:underline text-[11px] inline-flex items-center gap-0.5 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--sec)] rounded"
                    >
                      Verify &nearr;
                    </a>
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Print View: Clean Bulleted List (No Badges, No Boxes) -->
      <div class="hidden print:block">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-[10.5px]">
          {displayedBadges.map((cert) => (
            <li class="flex items-start gap-1.5 print-break-inside-avoid leading-snug">
              <span class="text-neutral-500 font-mono select-none flex-shrink-0">
                &bull;
              </span>
              <div class="min-w-0">
                <span class="font-semibold text-neutral-900">{cert.title}</span>
                <span class="text-neutral-600 text-[9.5px] font-mono">
                  {" "}
                  &mdash; {cert.issuer} ({cert.issueDate}
                  {cert.expiresDate ? ` · Exp: ${cert.expiresDate}` : ""})
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </CVSection>

    <!-- References Notice -->
    <div class="text-center py-8 print:py-2.5 border-t border-[#ffffff10] print:border-neutral-200 font-mono text-xs print:text-[9.5px] text-[var(--white-icon)] print:!text-neutral-500 print-break-inside-avoid">
      References available on request
    </div>
  </div>
</Layout>

<script>
  function setupCvPrint() {
    const printBtn = document.getElementById("cv-print-btn");
    const dialog = document.getElementById(
      "print-fallback-dialog",
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById("close-print-dialog");

    if (printBtn) {
      printBtn.addEventListener("click", () => {
        try {
          if (typeof window.print === "function") {
            window.print();
          } else if (dialog) {
            dialog.showModal();
          }
        } catch {
          if (dialog) dialog.showModal();
        }
      });
    }

    if (closeBtn && dialog) {
      closeBtn.addEventListener("click", () => dialog.close());
    }
  }

  setupCvPrint();
  document.addEventListener("astro:after-swap", setupCvPrint);
</script>
