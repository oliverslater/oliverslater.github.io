---
import BaseLayout from '../layouts/BaseLayout.astro';
import CVSection from '../components/CVSection.astro';
import profileData from '../content/cv/profile.json';
import experienceData from '../content/cv/experience.json';
import skillsData from '../content/cv/skills.json';
import educationData from '../content/cv/education.json';
---

<BaseLayout
  title={`CV & Resume | ${profileData.name}`}
  description={`Scannable curriculum vitae of ${profileData.name} - ${profileData.title}. Detailed work history, system architecture experience, and skill set.`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Top Action Bar (Print & Contact) -->
    <div class="no-print flex items-center justify-between pb-6 mb-8 border-b border-[#ffffff10]">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--white-icon)] hover:text-white transition-colors"
      >
        <span>&larr;</span> Back to Overview
      </a>

      <div class="flex items-center gap-2.5">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white)] hover:bg-[var(--white-icon-tr)] transition-colors"
        >
          <svg
            class="w-3.5 h-3.5 text-[var(--sec)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print / PDF
        </button>

        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-medium bg-[var(--sec)] text-black hover:opacity-90 transition-colors"
        >
          Contact Me
        </a>
      </div>
    </div>

    <!-- CV Header -->
    <header class="mb-14 pb-8 border-b border-[#ffffff10]">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-[#1414149c] border border-[var(--white-icon-tr)] text-[var(--sec)] mb-2">
          <span class="w-2 h-2 rounded-full bg-[#A9FF5B] animate-pulse"></span>
          AWS Golden Jacket Holder &middot; 11x AWS Certified
        </div>
        <h1 class="text-4xl sm:text-5xl font-medium tracking-tight text-[var(--white)]">
          {profileData.name}
        </h1>
        <p class="text-xl text-[var(--white-icon)] font-medium">
          {profileData.title}
        </p>
      </div>

      <!-- Contact and links grid -->
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-[var(--white-icon)]">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500">Location:</span>
          <span class="text-[var(--white)]">{profileData.location}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500">Email:</span>
          <a href={`mailto:${profileData.email}`} class="hover:text-[var(--sec)] transition-colors">
            {profileData.email}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500">Web:</span>
          <a href={profileData.website} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--sec)] transition-colors">
            {profileData.website.replace('https://', '')}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500">GitHub:</span>
          <a href={profileData.github} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--sec)] transition-colors">
            github.com/oliverslater
          </a>
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <CVSection title="Professional Summary">
      <div class="p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] leading-relaxed text-sm text-[var(--white-icon)] whitespace-pre-line">
        {profileData.bio}
      </div>
    </CVSection>

    <!-- Work Experience -->
    <CVSection title="Work Experience" badge={`${experienceData.roles.length} enterprise roles`}>
      <div class="relative border-l border-[#ffffff15] ml-2 space-y-12 pl-6 sm:pl-8">
        {
          experienceData.roles.map((role) => (
            <div class="relative print-page-break-inside-avoid">
              <!-- Timeline node marker -->
              <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3 h-3 rounded-full border-2 border-[var(--background)] bg-[var(--sec)]"></span>

              <div class="p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[#ffffff20] transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
                  <div>
                    <h3 class="text-lg font-semibold text-[var(--white)]">
                      {role.role}
                    </h3>
                    <div class="text-sm text-[var(--white-icon)] font-medium">
                      <span>{role.company}</span>
                      {role.location && (
                        <span class="text-neutral-500"> &middot; {role.location}</span>
                      )}
                    </div>
                  </div>

                  <div class="font-mono text-xs text-[var(--sec)] whitespace-nowrap">
                    <span>{role.startDate}</span> &mdash;{' '}
                    <span class={role.current ? 'text-[#A9FF5B] font-semibold' : ''}>
                      {role.endDate}
                    </span>
                  </div>
                </div>

                <p class="text-sm text-[var(--white-icon)] mt-3 mb-4 leading-relaxed">
                  {role.description}
                </p>

                {role.highlights && role.highlights.length > 0 && (
                  <ul class="space-y-2 mb-5">
                    {role.highlights.map((highlight) => (
                      <li class="flex items-start text-xs sm:text-sm text-[var(--white-icon)] leading-relaxed">
                        <span class="mr-2 text-[var(--sec)] font-mono">&bull;</span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {role.technologies && (
                  <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[var(--white-icon-tr)]">
                    {role.technologies.map((tech) => (
                      <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[#ffffff08] text-[var(--white-icon)] border border-[#ffffff10]">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- Technical Skills Matrix -->
    <CVSection title="Technical Capabilities & Tooling">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          skillsData.categories.map((category) => (
            <div class="p-5 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c]">
              <h3 class="font-mono text-xs font-semibold text-[var(--sec)] uppercase tracking-wider mb-3">
                {category.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {category.skills.map((skill) => (
                  <span class="px-2 py-0.5 rounded text-xs font-mono bg-[#ffffff08] text-[var(--white-icon)] border border-[#ffffff10]">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- Education & Professional Qualifications -->
    <CVSection title="Education & Professional Qualifications" badge={`${educationData.qualifications.length} credentials`}>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {
          educationData.qualifications.map((cert) => (
            <div class="p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] flex flex-col justify-between hover:border-[#ffffff20] transition-colors">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider bg-[#ffffff08] text-[var(--sec)] border border-[#ffffff10]">
                    {cert.issuer}
                  </span>
                  <span class="text-[11px] font-mono text-[var(--white-icon)]">
                    {cert.validity}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-[var(--white)] leading-snug">
                  {cert.title}
                </h3>
              </div>
              <div class="mt-3 text-xs font-mono text-neutral-500">
                Level: {cert.level}
              </div>
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- References Notice -->
    <div class="text-center py-8 border-t border-[#ffffff10] font-mono text-xs text-[var(--white-icon)]">
      References available on request
    </div>
  </div>
</BaseLayout>
