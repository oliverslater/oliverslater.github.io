---
import BaseLayout from '../layouts/BaseLayout.astro';
import CVSection from '../components/CVSection.astro';
import profileData from '../content/cv/profile.json';
import experienceData from '../content/cv/experience.json';
import skillsData from '../content/cv/skills.json';
import educationData from '../content/cv/education.json';
---

<BaseLayout
  title={`CV & Resume | ${profileData.name}`}
  description={`Scannable curriculum vitae of ${profileData.name} - ${profileData.title}. Detailed work history, system architecture experience, and skill set.`}
>
  <div class="max-w-3xl mx-auto">
    <!-- Top Action Bar (Print & Contact) -->
    <div class="no-print flex items-center justify-between pb-6 mb-8 border-b border-neutral-200 dark:border-neutral-800">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors"
      >
        <span>&larr;</span> Back to Overview
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono border border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:border-neutral-400 dark:hover:border-neutral-700 transition-colors"
        >
          <svg
            class="w-3.5 h-3.5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print / PDF
        </button>

        <a
          href="/contact"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
        >
          Contact Me
        </a>
      </div>
    </div>

    <!-- CV Header -->
    <header class="mb-12 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
          {profileData.name}
        </h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-300 font-medium">
          {profileData.title}
        </p>
      </div>

      <!-- Contact and links grid -->
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-neutral-600 dark:text-neutral-400">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-400 dark:text-neutral-600">Location:</span>
          <span>{profileData.location}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-400 dark:text-neutral-600">Email:</span>
          <a href={`mailto:${profileData.email}`} class="hover:underline">
            {profileData.email}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-400 dark:text-neutral-600">Web:</span>
          <a href={profileData.website} target="_blank" rel="noopener noreferrer" class="hover:underline">
            {profileData.website.replace('https://', '')}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-400 dark:text-neutral-600">GitHub:</span>
          <a href={profileData.github} target="_blank" rel="noopener noreferrer" class="hover:underline">
            github.com/oliverslater
          </a>
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <CVSection title="Professional Summary">
      <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {profileData.bio}
      </p>
    </CVSection>

    <!-- Work Experience -->
    <CVSection title="Work Experience" badge={`${experienceData.roles.length} roles`}>
      <div class="relative border-l border-neutral-200 dark:border-neutral-800 ml-2 space-y-10 pl-6">
        {
          experienceData.roles.map((role) => (
            <div class="relative print-page-break-inside-avoid">
              <!-- Timeline node marker -->
              <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full border-2 border-white dark:border-neutral-950 bg-neutral-400 dark:bg-neutral-600"></span>

              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1.5">
                <div>
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
                    {role.role}
                  </h3>
                  <div class="text-sm text-neutral-600 dark:text-neutral-400">
                    <span class="font-medium text-neutral-800 dark:text-neutral-200">{role.company}</span>
                    {role.location && (
                      <span class="text-neutral-400 dark:text-neutral-600"> &middot; {role.location}</span>
                    )}
                  </div>
                </div>

                <div class="font-mono text-xs text-neutral-500 whitespace-nowrap">
                  <span>{role.startDate}</span> &mdash;{' '}
                  <span class={role.current ? 'text-emerald-600 dark:text-emerald-400 font-medium' : ''}>
                    {role.endDate}
                  </span>
                </div>
              </div>

              <p class="text-sm text-neutral-700 dark:text-neutral-300 mt-2 mb-3 leading-relaxed">
                {role.description}
              </p>

              {role.highlights && role.highlights.length > 0 && (
                <ul class="space-y-1.5 mb-4">
                  {role.highlights.map((highlight) => (
                    <li class="flex items-start text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                      <span class="mr-2 text-neutral-400 dark:text-neutral-600">&bull;</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}

              {role.technologies && (
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {role.technologies.map((tech) => (
                    <span class="px-2 py-0.5 rounded text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- Technical Skills Matrix -->
    <CVSection title="Technical Capabilities & Tooling">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          skillsData.categories.map((category) => (
            <div class="p-4 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-900/30">
              <h3 class="font-mono text-xs font-semibold text-neutral-800 dark:text-neutral-200 uppercase tracking-wider mb-2.5">
                {category.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {category.skills.map((skill) => (
                  <span class="px-2 py-0.5 rounded text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- Education & Professional Qualifications -->
    <CVSection title="Education & Professional Qualifications" badge={`${educationData.qualifications.length} credentials`}>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          educationData.qualifications.map((cert) => (
            <div class="p-3.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/40 dark:bg-neutral-900/30 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
                    {cert.issuer}
                  </span>
                  <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
                    {cert.validity}
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 leading-snug">
                  {cert.title}
                </h3>
              </div>
              <div class="mt-2 text-xs font-mono text-neutral-500">
                Level: {cert.level}
              </div>
            </div>
          ))
        }
      </div>
    </CVSection>

    <!-- References Notice -->
    <div class="text-center py-6 border-t border-neutral-200 dark:border-neutral-800 font-mono text-xs text-neutral-500">
      References available on request
    </div>
  </div>
</BaseLayout>
