{
  "name": "oliverslater.github.io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/sync-cv-version.mjs && node scripts/generate-sitemap.mjs",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "postbuild": "node scripts/generate-pdf.mjs",
    "build:fresh": "FORCE_REFRESH_CERTS=true ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:hygiene": "node scripts/check-file-hygiene.mjs",
    "check:links": "node scripts/check-links-and-html.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "lint:md": "markdownlint \"src/content/**/*.md\"",
    "lint:spelling": "cspell \"src/**/*.{md,astro,ts,tsx,json}\" \"README.md\" \"llms.txt\"",
    "compress": "node scripts/compress-assets.mjs",
    "validate:yaml": "node scripts/validate-yaml.mjs",
    "validate:json": "node scripts/validate-json.mjs",
    "validate:blog": "node scripts/validate-blog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run test && npm run validate:yaml && npm run validate:json && npm run validate:blog && npm run lint:md && npm run lint:spelling && npm run check:sync && npm run check:hygiene && npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "pdf": "node scripts/generate-pdf.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{yml,yaml}": "node scripts/validate-yaml.mjs",
    "*.json": "node scripts/validate-json.mjs",
    "*.md": [
      "node scripts/validate-blog.mjs",
      "markdownlint"
    ],
    "*.{astro,ts,tsx,js,mjs,md,json}": [
      "cspell --no-must-find-files"
    ],
    "*": "node scripts/check-file-hygiene.mjs",
    "*.{astro,ts,tsx,js,mjs,md,css}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-en-gb": "^5.0.34",
    "@types/node": "^26.6.2",
    "cspell": "^10.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
