{
  "name": "oliverslater.github.io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "astro build",
    "build:fresh": "FORCE_REFRESH_CERTS=true astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:hygiene": "node scripts/check-file-hygiene.mjs",
    "validate:yaml": "node scripts/validate-yaml.mjs",
    "validate:json": "node scripts/validate-json.mjs",
    "validate": "npm run validate:yaml && npm run validate:json && npm run check:hygiene && npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{yml,yaml}": "node scripts/validate-yaml.mjs",
    "*.json": "node scripts/validate-json.mjs",
    "*": "node scripts/check-file-hygiene.mjs",
    "*.{astro,ts,tsx,js,mjs,md,css}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.4",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.0.0"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {
    "@astrojs/tailwind": {
      "astro": "$astro"
    }
  }
}
