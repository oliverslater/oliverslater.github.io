# Headless Form Endpoint (Web3Forms, Formspree, or custom endpoint)
# Web3Forms example: https://api.web3forms.com/submit
# Formspree example: https://formspree.io/f/{your_form_id}
PUBLIC_FORM_ENDPOINT="https://api.web3forms.com/submit"
# If using Web3Forms, supply your access key:
PUBLIC_WEB3FORMS_KEY="YOUR_WEB3FORMS_ACCESS_KEY"
