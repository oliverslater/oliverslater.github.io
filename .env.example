# Contact email for CV (kept private / omitted from public repo)
CONTACT_EMAIL=contact@example.com

# Web3Forms access key
PUBLIC_WEB3FORMS_KEY=

# Formspree or custom webhook endpoint (alternative to Web3Forms)
PUBLIC_FORM_ENDPOINT=

# Optional hCaptcha site key (leave blank to use Web3Forms default free site key)
PUBLIC_HCAPTCHA_SITEKEY=
